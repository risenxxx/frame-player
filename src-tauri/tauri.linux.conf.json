{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBundleCommand": "test -n \"$FP_DEB_DEPENDS\" || { echo 'Linux bundles are built with `bun run tauri:linux:build`: the .deb takes its Depends from this machine (scripts/linux/deb-depends.sh)' >&2; exit 1; }"
  },
  "bundle": {
    "targets": ["deb", "appimage"],
    "resources": {
      "lib/**/*": null,
      "ffmpeg/bin/*.dll": null,
      "ffmpeg/bin/ffmpeg.*": null,
      "lua/*.lua": "lua/",
      "shaders/*.glsl": "shaders/",
      "../THIRD-PARTY-NOTICES.md": "./",
      "../LICENSE": "./"
    },
    "fileAssociations": [
      { "ext": ["mp4"], "mimeType": "video/mp4", "name": "Video", "role": "Viewer" },
      { "ext": ["m4v"], "mimeType": "video/x-m4v", "name": "Video", "role": "Viewer" },
      { "ext": ["mkv"], "mimeType": "video/x-matroska", "name": "Video", "role": "Viewer" },
      { "ext": ["webm"], "mimeType": "video/webm", "name": "Video", "role": "Viewer" },
      { "ext": ["avi"], "mimeType": "video/x-msvideo", "name": "Video", "role": "Viewer" },
      { "ext": ["mov"], "mimeType": "video/quicktime", "name": "Video", "role": "Viewer" },
      { "ext": ["wmv"], "mimeType": "video/x-ms-wmv", "name": "Video", "role": "Viewer" },
      { "ext": ["flv"], "mimeType": "video/x-flv", "name": "Video", "role": "Viewer" },
      { "ext": ["ts", "m2ts", "mts"], "mimeType": "video/mp2t", "name": "Video", "role": "Viewer" },
      { "ext": ["mpg", "mpeg", "vob"], "mimeType": "video/mpeg", "name": "Video", "role": "Viewer" },
      { "ext": ["ogv"], "mimeType": "video/ogg", "name": "Video", "role": "Viewer" },
      { "ext": ["3gp"], "mimeType": "video/3gpp", "name": "Video", "role": "Viewer" }
    ],
    "linux": {
      "deb": {
        "section": "video",
        "recommends": ["ffmpeg"],
        "desktopTemplate": "linux/frameplayer.desktop"
      }
    }
  }
}
