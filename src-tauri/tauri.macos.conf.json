{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "macOSPrivateApi": true
  },
  "bundle": {
    "targets": ["app"],
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "resources": {
      "ffmpeg/bin/*.dll": null,
      "ffmpeg/bin/ffmpeg.*": null,
      "ffmpeg-macos/bin/ffmpeg": "./",
      "lib/**/*": "lib/",
      "../THIRD-PARTY-NOTICES.md": "./",
      "../LICENSE": "./"
    }
  }
}
