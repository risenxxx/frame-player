{
  "name": "frameplayer",
  "version": "1.23.0",
  "description": "A video player for Windows and macOS built on Tauri 2 and libmpv: local files, links and live torrent streaming in one window, frame-accurate seeking, and an unusual amount of attention to detail",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "css-orphans": "node scripts/css-orphans.mjs",
    "check-runes": "node scripts/check-runes.mjs",
    "check-imports": "node scripts/check-imports.mjs",
    "notices": "node scripts/gen-notices.mjs",
    "notices:check": "node scripts/gen-notices.mjs --check",
    "changelog:check": "node scripts/changelog.mjs check",
    "changelog:preview": "node scripts/changelog.mjs preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "gates": "bun run check && bun run check-runes && bun run check-imports && bun run css-orphans && bun run notices:check && bun run changelog:check && bun run test",
    "tauri": "tauri",
    "set-version": "node scripts/set-version.mjs",
    "tauri:macos": "env FFMPEG_DIR=\"$PWD/src-tauri/ffmpeg-macos\" LIBCLANG_PATH=/Library/Developer/CommandLineTools/usr/lib tauri dev",
    "tauri:macos:build": "scripts/macos-build.sh",
    "tauri:macos:dmg": "scripts/build-dmg.sh",
    "fetch-libs": "powershell -ExecutionPolicy Bypass -File scripts/fetch-libs.ps1"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "tauri-plugin-libmpv-api": "^0.3.2"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@changesets/parse": "^0.4.3",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "@vitest/coverage-v8": "^4.1.10",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
