+    int (*overlay_size)(struct libmpv_gpu_context *ctx, mpv_render_param *params,
+                        int *out_w, int *out_h);
+    // Acquire the overlay target (only called when there is something to
+    // draw), and hand it back like finish_frame().
+    int (*wrap_overlay)(struct libmpv_gpu_context *ctx, mpv_render_param *params,
+                        struct ra_tex **out);
+    int (*finish_overlay)(struct libmpv_gpu_context *ctx, bool ok);
+    // Report what happened to the overlay target, and where the video
+    // target's picture goes in the element.
+    void (*overlay_result)(struct libmpv_gpu_context *ctx, mpv_render_param *params,
+                           bool rendered, const struct mp_rect *src,
+                           const struct mp_rect *dst);
     // Free all data in ctx->priv.
     void (*destroy)(struct libmpv_gpu_context *ctx);
 };
