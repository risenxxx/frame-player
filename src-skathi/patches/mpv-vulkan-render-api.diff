+// Rasterise the OSD and subtitles for the overlay target (osd_res, the
+// element) and return how many overlays there are. Nothing is drawn yet.
+int mppl_video_prepare_overlay(struct mppl_video *p, struct vo_frame *frame)
+{
+    const struct gl_video_opts *opts = p->opts_cache->opts;
+    struct pl_frame dummy = {0};
+    stats_time_start(p->stats, "osd-update");
+    update_overlays(p, p->osd_res,
+                    (frame->current && opts->blend_subs) ? OSD_DRAW_OSD_ONLY : 0,
+                    PL_OVERLAY_COORDS_DST_FRAME, &p->osd_state, &dummy, frame->current,
+                    frame->current ? frame->current->params.stereo3d : 0, get_ref_luma(p));
+    stats_time_end(p->stats, "osd-update");
+    return dummy.num_overlays;
+}
+
+// Draw the overlays prepared by mppl_video_prepare_overlay() into an
+// element-sized target, cleared to transparent black. The result is
+// premultiplied (libplacebo's overlay blend: rgb = src*a + dst*(1-a),
+// a = a + dst_a*(1-a)), in the same colour space as the video target.
+bool mppl_video_render_overlay(struct mppl_video *p, struct vo_frame *frame,
+                               const struct pl_swapchain_frame *swframe)
+{
+    pl_gpu gpu = p->gpu;
+    if (!p->rr_overlay)
+        p->rr_overlay = pl_renderer_create(p->pllog, gpu);
+    struct pl_frame target;
+    setup_target(p, frame, swframe, NULL, &target);
+    target.overlays = p->osd_state.overlays;
+    target.num_overlays = p->osd_state.num_overlays;
+    struct mp_rect all = { 0, 0, swframe->fbo->params.w, swframe->fbo->params.h };
+    apply_crop(&target, all, swframe->fbo->params.w, swframe->fbo->params.h);
+
+    struct frame_params fpar = get_frame_params(p, frame);
+    struct pl_render_params params = fpar.params;
+    params.border = PL_CLEAR_COLOR;
+    params.background_color[0] = params.background_color[1] = params.background_color[2] = 0;
+    params.background_transparency = 1.0;
+    params.blend_params = NULL;
+    stats_time_start(p->stats, "osd-render");
+    bool ok = pl_render_image(p->rr_overlay, NULL, &target, &params);
+    stats_time_end(p->stats, "osd-render");
+    if (!ok) {
+        MP_ERR(p, "Failed rendering the overlay target!\n");
+        pl_tex_clear(gpu, swframe->fbo, (float[4]){ 0.0, 0.0, 0.0, 0.0 });
+    }
+    pl_gpu_flush(gpu);
+    return ok;
+}
