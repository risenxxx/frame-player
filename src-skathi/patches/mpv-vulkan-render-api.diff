+#ifndef MPV_CLIENT_API_RENDER_VK_H_
+#define MPV_CLIENT_API_RENDER_VK_H_
+
+#include <stdint.h>
+#include <vulkan/vulkan_core.h>
+
+#include "render.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * Vulkan backend (DOWNSTREAM DRAFT, parameter IDs not reserved upstream)
+ * ----------------------------------------------------------------------
+ *
+ * The API user owns the Vulkan instance, the device, the queues, the target
+ * images and the semaphores. mpv borrows them; it never creates or destroys
+ * any of them. Only the gpu-next renderer supports this API:
+ * MPV_RENDER_PARAM_RENDERER must be omitted or "gpu-next"; "gpu" fails with
+ * MPV_ERROR_NOT_IMPLEMENTED.
+ *
+ * Creation
+ * --------
+ *
+ *   MPV_RENDER_PARAM_API_TYPE         = MPV_RENDER_API_TYPE_VULKAN
+ *   MPV_RENDER_PARAM_VULKAN_INIT_PARAMS = mpv_vulkan_init_params*
+ *
+ * The device must be Vulkan 1.2 or newer and must have been created with the
+ * timelineSemaphore and hostQueryReset features enabled.
+ * Enable synchronization2 (core in 1.3, or VK_KHR_synchronization2) as
+ * well: without it libplacebo's legacy barrier path records barriers with
+ * srcStageMask = 0, which the validation layers reject. Everything the
+ * device was created with (extensions, the feature chain) must be described
+ * in mpv_vulkan_init_params, because the renderer chooses its code paths from
+ * it. The objects must stay alive until mpv_render_context_free() returns.
+ *
+ * Rendering
+ * ---------
+ *
+ * mpv_render_context_render() takes MPV_RENDER_PARAM_VULKAN_FBO, which names
+ * one 2D, single-sampled, single-layer color image and how to synchronize
+ * with it:
+ *
+ *   1. mpv waits on (acquire_semaphore, acquire_value) on the GPU before it
+ *      touches the image; with no acquire semaphore the image must be ready
+ *      when the call is made. `layout` is the image's layout once the wait is
+ *      satisfied (VK_IMAGE_LAYOUT_UNDEFINED discards the contents).
+ *   2. mpv records and submits its rendering.
+ *   3. mpv submits a transition to `final_layout` and a signal of
+ *      (release_semaphore, release_value). When the call returns successfully
+ *      that signal has been submitted to the queue, so the API user may wait
+ *      on it from another queue or API. The image belongs to the API user
+ *      again from that point on the GPU timeline.
+ *
+ * Both semaphores must be timeline semaphores (they may be the same one, with
+ * release_value > acquire_value). mpv does not wait on the CPU for the GPU.
+ *
+ * Errors: if mpv_render_context_render() fails with
+ * MPV_ERROR_INVALID_PARAMETER or MPV_ERROR_UNSUPPORTED, mpv did not touch the
+ * image and submitted nothing (the acquire value has not been consumed).
+ * MPV_ERROR_GENERIC means rendering failed after the image was acquired; mpv
+ * still tried to submit the release signal, and the API user must not rely on
+ * it: retire the image (below) before reusing or destroying it. After a lost
+ * device the render context must be destroyed.
+ *
+ * MPV_RENDER_PARAM_SKIP_RENDERING: mpv ignores MPV_RENDER_PARAM_VULKAN_FBO
+ * (and MPV_RENDER_PARAM_VULKAN_OVERLAY_FBO) entirely. Nothing is waited on,
+ * nothing is signalled, the acquire value is not consumed and the image's
+ * contents and layout are unchanged; the call returns 0. A skip is not a
+ * release: never wait for release_value after one.
+ *
+ * Image identity and retirement
+ * -----------------------------
+ *
+ * mpv keeps a small cache of wrappers keyed by the VkImage handle and its
+ * description, so rendering into a ring of images does not re-wrap each one
+ * every frame. A Vulkan handle can be reused by the driver after the image is
+ * destroyed, so before destroying (or re-creating) a target image the API
+ * user must retire it:
+ *
+ *   mpv_render_context_set_parameter(ctx, (mpv_render_param){
+ *       MPV_RENDER_PARAM_VULKAN_RETIRE, &(VkImage){image} });
+ *
+ * Retiring waits until the GPU has finished all work mpv submitted and until
+ * the last release value mpv submitted for each retired image is visible
+ * (vkGetSemaphoreCounterValue) - a CPU wait; do it outside the frame loop -
+ * then forgets the image. Work of the API user's own consumers (a Metal copy
+ * waiting on the release value) is not covered: wait for it separately before
+ * freeing the image. Call it from
+ * the thread that renders, never concurrently with
+ * mpv_render_context_render(). A NULL data
+ * pointer, or VK_NULL_HANDLE, retires every image. After it returns, mpv holds
+ * no reference to the image or to any semaphore that was passed with it, so
+ * both may be destroyed once the API user's own consumers are done.
+ *
+ * Threading
+ * ---------
+ *
+ * The general rules of render.h apply. mpv submits to the queue given in the
+ * init params from the render thread and, with hardware decoding, uploads
+ * from other threads. If the API user submits to the same VkQueue, it must
+ * provide lock_queue/unlock_queue; otherwise mpv locks the queue internally
+ * and the API user must not touch it.
+ */
+
+#define MPV_RENDER_API_TYPE_VULKAN "vulkan"
+
+/**
+ * Parameter IDs of this draft. They are deliberately far away from the
+ * upstream range so that a later upstream assignment cannot collide.
+ */
+enum {
+    /**
+     * Required for mpv_render_context_create() with MPV_RENDER_API_TYPE_VULKAN.
+     * Type: mpv_vulkan_init_params*
+     */
+    MPV_RENDER_PARAM_VULKAN_INIT_PARAMS = 0x7601,
+    /**
+     * The target of one mpv_render_context_render() call.
+     * Type: mpv_vulkan_fbo*
+     */
+    MPV_RENDER_PARAM_VULKAN_FBO = 0x7602,
+    /**
+     * For mpv_render_context_set_parameter(): wait for mpv's GPU work and
+     * forget one image (or every image with NULL / VK_NULL_HANDLE).
+     * Type: VkImage* (may be NULL)
+     */
+    MPV_RENDER_PARAM_VULKAN_RETIRE = 0x7603,
+    /**
+     * Optional, with MPV_RENDER_PARAM_VULKAN_FBO: a second, element-sized
+     * target for subtitles and the OSD. See mpv_vulkan_overlay_fbo.
+     * Type: mpv_vulkan_overlay_fbo* (mpv writes its output fields)
+     */
+    MPV_RENDER_PARAM_VULKAN_OVERLAY_FBO = 0x7604,
+};
+
+typedef struct mpv_vulkan_init_params {
+    /** Size of this struct, for versioning. Set to sizeof(mpv_vulkan_init_params). */
+    size_t struct_size;
+
+    VkInstance instance;
+    /** The vkGetInstanceProcAddr the instance was created through (required). */
+    PFN_vkGetInstanceProcAddr get_instance_proc_addr;
+    VkPhysicalDevice physical_device;
+    VkDevice device;
+    /**
+     * The API version the instance and device were created for (at least
+     * VK_API_VERSION_1_2). mpv uses no functionality above it.
+     */
+    uint32_t api_version;
+
+    /** All device extensions the device was created with. */
+    const char *const *extensions;
+    int num_extensions;
+    /**
+     * The feature chain the device was created with (VkPhysicalDeviceFeatures2
+     * and its pNext structs). Must include timelineSemaphore and
+     * hostQueryReset.
+     */
+    const VkPhysicalDeviceFeatures2 *features;
+
+    /** A queue family with graphics (and ideally compute) support. */
+    uint32_t queue_family_index;
+    /** How many queues of that family the device was created with (>= 1). */
+    uint32_t queue_count;
+
+    /**
+     * Optional. If the API user submits to the same queues, mpv calls these
+     * around each of its own queue operations. Both or neither must be set.
+     */
+    void (*lock_queue)(void *ctx, uint32_t queue_family, uint32_t queue_index);
+    void (*unlock_queue)(void *ctx, uint32_t queue_family, uint32_t queue_index);
+    void *queue_ctx;
+} mpv_vulkan_init_params;
+
+typedef struct mpv_vulkan_fbo {
+    /** Size of this struct, for versioning. Set to sizeof(mpv_vulkan_fbo). */
+    size_t struct_size;
+
+    /**
+     * A 2D image with one mip level, one layer and one sample, created on the
+     * device from the init params with VK_SHARING_MODE_EXCLUSIVE and
+     * VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT (TRANSFER_DST and SAMPLED help some
+     * code paths). Any format libplacebo can render to; RGBA16F keeps values
+     * above 1.0 for HDR.
+     */
+    VkImage image;
+    int w, h;
+    VkFormat format;
+    /** The usage flags the image was created with. */
+    VkImageUsageFlags usage;
+
+    /** Layout when the acquire wait is satisfied; UNDEFINED discards contents. */
+    VkImageLayout layout;
+    /** Layout the image is left in when the release signal fires. */
+    VkImageLayout final_layout;
+    /**
+     * Queue family ownership transfer. VK_QUEUE_FAMILY_IGNORED (the usual
+     * value) does none; VK_QUEUE_FAMILY_EXTERNAL acquires from and releases to
+     * an external API, which then has to perform the matching transfers.
+     */
+    uint32_t queue_family;
+
+    /** Optional timeline semaphore mpv waits on before using the image. */
+    VkSemaphore acquire_semaphore;
+    uint64_t acquire_value;
+    /** Required timeline semaphore mpv signals when it is done with the image. */
+    VkSemaphore release_semaphore;
+    uint64_t release_value;
+} mpv_vulkan_fbo;
+
+/**
+ * Overlay target (MPV_RENDER_PARAM_VULKAN_OVERLAY_FBO)
+ * ---------------------------------------------------
+ *
+ * Splits a frame into a picture and an overlay, so that the picture can be
+ * rendered at the video's size while subtitles and the OSD stay sharp at the
+ * size of the element that shows them.
+ *
+ * With this parameter, mpv lays the frame out for an element of
+ * target.w x target.h (zoom, pan, crop, rotation, letterboxing, subtitle
+ * placement: all as if that were the render size). Then:
+ *
+ *   1. The picture pass renders the visible part of the video (source_rect)
+ *      into the whole MPV_RENDER_PARAM_VULKAN_FBO image, whatever its size,
+ *      and draws no OSD or subtitles into it (blend-subtitles still blends
+ *      into the picture). Its release is signalled as usual.
+ *   2. The overlay pass draws the OSD and subtitles into `target`, cleared to
+ *      transparent black. The result is premultiplied alpha, in the same
+ *      colour space as the picture target (same target-trc/prim/peak), so
+ *      "picture placed at video_rect, then overlay over the whole element"
+ *      (out = overlay + (1 - overlay.a) * picture) reproduces a single pass
+ *      as long as both are blended in that same space.
+ *   3. If there is nothing to draw, `rendered` is 0 and `target` was not
+ *      touched: no acquire was consumed, no release is signalled, and the
+ *      contents are whatever they were. Hide the overlay layer then.
+ *
+ * Both targets follow the rules of mpv_vulkan_fbo; they must be different
+ * images. The overlay release is submitted after the picture's. On an error
+ * return, `rendered` says whether the overlay target was acquired (the
+ * MPV_ERROR_GENERIC rules apply to whichever was).
+ */
+typedef struct mpv_vulkan_overlay_fbo {
+    /** Size of this struct, for versioning. Set to sizeof(mpv_vulkan_overlay_fbo). */
+    size_t struct_size;
+    /** The element-sized target, with its own synchronization. */
+    mpv_vulkan_fbo target;
+
+    /** Out: 1 if `target` was acquired, drawn and released; 0 if untouched. */
+    int rendered;
+    /** Out: where the picture target belongs in the element, in element
+     *  pixels: x0, y0, x1, y1 (clipped to the element). */
+    int video_rect[4];
+    /** Out: the part of the video that the picture target holds, in video
+     *  pixels: x0, y0, x1, y1 (useful to choose the picture target's size). */
+    int source_rect[4];
+    /** In: how the picture pass lays out the MPV_RENDER_PARAM_VULKAN_FBO image.
+     *  MPV_VULKAN_PICTURE_SOURCE (0): the visible part of the video fills the
+     *  whole image (place it at video_rect). MPV_VULKAN_PICTURE_ELEMENT (1): the
+     *  image is the whole element scaled to the image's size, letterbox
+     *  included, with zoom, pan, crop and rotation applied exactly as in the
+     *  overlay: show it stretched over the element. One layout, one transform
+     *  for both images. */
+    int picture_layout;
+} mpv_vulkan_overlay_fbo;
+
+#define MPV_VULKAN_PICTURE_SOURCE 0
+#define MPV_VULKAN_PICTURE_ELEMENT 1
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
