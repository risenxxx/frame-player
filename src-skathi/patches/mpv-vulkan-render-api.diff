+    int (*finish_frame)(struct libmpv_gpu_context *ctx, bool ds, bool ok);
+    // Optional. Context-specific mpv_render_context_set_parameter() values.
+    int (*set_parameter)(struct libmpv_gpu_context *ctx, mpv_render_param param);
+    // Optional: a separate, element-sized overlay target (gpu-next only).
