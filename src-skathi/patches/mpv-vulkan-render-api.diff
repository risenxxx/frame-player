@@ -33,6 +37,31 @@ struct libmpv_gpu_context_fns {
     // For certain backends, this might also be used to signal the end of
     // rendering (like OpenGL doing weird crap).
     void (*done_frame)(struct libmpv_gpu_context *ctx, bool ds);
+    // Optional. Report the size of the target in the params without acquiring
+    // it. If NULL, wrap_fbo() is used, which must then have no side effects.
+    int (*get_target_size)(struct libmpv_gpu_context *ctx,
+                           mpv_render_param *params, int *out_w, int *out_h);
+    // Optional, used instead of done_frame() where present. ok tells whether
+    // rendering succeeded. Returns a libmpv error code: the image could not be
