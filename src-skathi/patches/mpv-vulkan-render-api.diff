+
+// The render API on a Vulkan device owned by the API user (gpu-next only).
+// The device is imported into libplacebo; targets are the API user's VkImages,
+// wrapped once and kept in a small cache; acquire and release are timeline
+// semaphore waits and signals that libplacebo submits with its own work.
+
+#include <stdlib.h>
+
+#include <libplacebo/vulkan.h>
+
+#include "common/common.h"
+#include "common/msg.h"
+#include "osdep/timer.h"
+#include "mpv/render_vk.h"
+#include "video/out/gpu/libmpv_gpu.h"
+#include "video/out/gpu/context.h"
+#include "video/out/gpu/ra.h"
+#include "video/out/placebo/ra_pl.h"
+#include "video/out/placebo/utils.h"
+
+#define MAX_TARGETS 8
+
+struct target {
+    VkImage image;
+    int w, h;
+    VkFormat format;
+    VkImageUsageFlags usage;
+    pl_tex tex;
+    uint64_t last_used;
+    // The last release signal submitted for this image (0: none).
+    VkSemaphore release_sem;
+    uint64_t release_value;
+};
+
+struct priv {
+    pl_log pllog;
+    pl_vulkan vk;
+    VkDevice device;
+    PFN_vkWaitSemaphores WaitSemaphores;
+    PFN_vkGetSemaphoreCounterValue GetSemaphoreCounterValue;
+    struct target targets[MAX_TARGETS];
+    uint64_t frame_count;
+
+    // State of the frame between wrap_fbo() and finish_frame().
+    struct target *cur;
+    struct ra_tex cur_ratex;
+    mpv_vulkan_fbo cur_fbo;
+    // The same for the overlay target, between wrap_overlay() and
+    // finish_overlay().
+    struct target *cur_ovl;
+    struct ra_tex cur_ovl_ratex;
+    mpv_vulkan_fbo cur_ovl_fbo;
+};
+
+static void forget_target(struct libmpv_gpu_context *ctx, struct target *t)
+{
+    struct priv *p = ctx->priv;
+    if (t->tex)
+        pl_tex_destroy(p->vk->gpu, &t->tex);
+    *t = (struct target){0};
+}
+
+static int init(struct libmpv_gpu_context *ctx, mpv_render_param *params)
+{
+    struct priv *p = ctx->priv = talloc_zero(NULL, struct priv);
+
+    mpv_vulkan_init_params *ip =
+        get_mpv_render_param(params, MPV_RENDER_PARAM_VULKAN_INIT_PARAMS, NULL);
+    if (!ip || ip->struct_size < sizeof(*ip) || !ip->instance ||
+        !ip->get_instance_proc_addr || !ip->physical_device || !ip->device ||
+        !ip->features || ip->queue_count < 1 ||
+        !ip->lock_queue != !ip->unlock_queue)
+    {
+        MP_ERR(ctx, "Missing or incomplete MPV_RENDER_PARAM_VULKAN_INIT_PARAMS.\n");
+        return MPV_ERROR_INVALID_PARAMETER;
+    }
+
+    p->pllog = mppl_log_create(p, ctx->log);
+    if (!p->pllog)
+        return MPV_ERROR_GENERIC;
+
+    p->vk = pl_vulkan_import(p->pllog, pl_vulkan_import_params(
+        .instance = ip->instance,
+        .get_proc_addr = ip->get_instance_proc_addr,
+        .phys_device = ip->physical_device,
+        .device = ip->device,
+        .extensions = ip->extensions,
+        .num_extensions = ip->num_extensions,
+        .queue_graphics = {
+            .index = ip->queue_family_index,
+            .count = (int)ip->queue_count,
+        },
+        .features = ip->features,
+        .lock_queue = ip->lock_queue,
+        .unlock_queue = ip->unlock_queue,
+        .queue_ctx = ip->queue_ctx,
+        .max_api_version = ip->api_version,
+    ));
+    if (!p->vk) {
+        MP_ERR(ctx, "Failed to import the Vulkan device into libplacebo.\n");
+        return MPV_ERROR_UNSUPPORTED;
+    }
+
+    // Retirement waits for the release signals themselves (see
+    // wait_released()); resolve the two entry points it needs.
+    PFN_vkGetDeviceProcAddr gdpa = (PFN_vkGetDeviceProcAddr)
+        ip->get_instance_proc_addr(ip->instance, "vkGetDeviceProcAddr");
+    if (gdpa) {
+        p->WaitSemaphores = (PFN_vkWaitSemaphores)gdpa(ip->device, "vkWaitSemaphores");
+        p->GetSemaphoreCounterValue = (PFN_vkGetSemaphoreCounterValue)
+            gdpa(ip->device, "vkGetSemaphoreCounterValue");
+    }
+    if (!p->WaitSemaphores || !p->GetSemaphoreCounterValue) {
+        MP_ERR(ctx, "The device has no timeline semaphore entry points.\n");
+        return MPV_ERROR_UNSUPPORTED;
+    }
+    p->device = ip->device;
+
+    struct ra_ctx *ra_ctx = talloc_zero(p, struct ra_ctx);
+    ra_ctx->log = ctx->log;
+    ra_ctx->global = ctx->global;
+    ra_ctx->ra = ra_create_pl(p->vk->gpu, ctx->log);
+    if (!ra_ctx->ra)
+        return MPV_ERROR_UNSUPPORTED;
+
+    ctx->ra_ctx = ra_ctx;
+    return 0;
+}
+
+static bool fbo_valid(const mpv_vulkan_fbo *fbo)
+{
+    return fbo && fbo->struct_size >= sizeof(*fbo) && fbo->image &&
+           fbo->w >= 1 && fbo->h >= 1;
+}
+
+static bool sync_valid(struct libmpv_gpu_context *ctx, const mpv_vulkan_fbo *fbo)
+{
+    if (!fbo->release_semaphore) {
+        MP_ERR(ctx, "mpv_vulkan_fbo.release_semaphore is required.\n");
+        return false;
+    }
+    if (fbo->acquire_semaphore == fbo->release_semaphore &&
+        fbo->release_value <= fbo->acquire_value)
+    {
+        MP_ERR(ctx, "release_value must be above acquire_value.\n");
+        return false;
+    }
+    return true;
+}
+
+static int overlay_size(struct libmpv_gpu_context *ctx, mpv_render_param *params,
+                        int *out_w, int *out_h)
+{
+    mpv_vulkan_overlay_fbo *ov =
+        get_mpv_render_param(params, MPV_RENDER_PARAM_VULKAN_OVERLAY_FBO, NULL);
+    if (!ov)
+        return 1;
+    if (ov->struct_size < sizeof(*ov) || !fbo_valid(&ov->target) ||
+        !sync_valid(ctx, &ov->target))
+        return MPV_ERROR_INVALID_PARAMETER;
+    *out_w = ov->target.w;
+    *out_h = ov->target.h;
+    return ov->picture_layout == MPV_VULKAN_PICTURE_ELEMENT ? 2 : 0;
+}
+
+// With an overlay target, mpv lays the picture out for the element (the
+// overlay's size); the video target only receives the visible picture.
+static int get_target_size(struct libmpv_gpu_context *ctx,
+                           mpv_render_param *params, int *out_w, int *out_h)
+{
+    mpv_vulkan_fbo *fbo = get_mpv_render_param(params, MPV_RENDER_PARAM_VULKAN_FBO, NULL);
+    if (!fbo_valid(fbo))
+        return MPV_ERROR_INVALID_PARAMETER;
+    int err = overlay_size(ctx, params, out_w, out_h);
+    if (err < 0)
+        return err;
+    if (err != 1) // an overlay target: the layout is the element's
+        return 0;
+    *out_w = fbo->w;
+    *out_h = fbo->h;
+    return 0;
+}
+
+static struct target *find_target(struct libmpv_gpu_context *ctx,
+                                  const mpv_vulkan_fbo *fbo)
+{
+    struct priv *p = ctx->priv;
+    struct target *free_slot = NULL, *oldest = NULL;
+
+    for (int n = 0; n < MAX_TARGETS; n++) {
+        struct target *t = &p->targets[n];
+        if (!t->tex) {
+            free_slot = free_slot ? free_slot : t;
+            continue;
+        }
+        if (t->image == fbo->image) {
+            if (t->w == fbo->w && t->h == fbo->h && t->format == fbo->format &&
+                t->usage == fbo->usage)
+                return t;
+            // Same handle with a different description: the API user
+            // re-created the image without retiring it. The old one may still
+            // be in flight, so wait for it before letting it go.
+            MP_WARN(ctx, "Vulkan target re-described without retiring it.\n");
+            pl_gpu_finish(p->vk->gpu);
+            forget_target(ctx, t);
+            free_slot = t;
+            break;
+        }
+        if (!oldest || t->last_used < oldest->last_used)
+            oldest = t;
+    }
+
+    struct target *t = free_slot;
+    if (!t) {
+        // More distinct images than the cache holds. Evicting is safe but
+        // costs a wait: the API user is cycling more images than expected.
+        MP_VERBOSE(ctx, "Vulkan target cache full, evicting one.\n");
+        pl_gpu_finish(p->vk->gpu);
+        forget_target(ctx, oldest);
+        t = oldest;
+    }
+
+    pl_tex tex = pl_vulkan_wrap(p->vk->gpu, pl_vulkan_wrap_params(
+        .image = fbo->image,
+        .width = fbo->w,
+        .height = fbo->h,
+        .format = fbo->format,
+        .usage = fbo->usage,
+    ));
+    if (!tex) {
+        MP_ERR(ctx, "Failed to wrap the Vulkan target image.\n");
+        return NULL;
+    }
+    if (!tex->params.renderable) {
+        MP_ERR(ctx, "The Vulkan target is not renderable (usage or format).\n");
+        pl_tex_destroy(p->vk->gpu, &tex);
+        return NULL;
+    }
+    *t = (struct target){
+        .image = fbo->image,
+        .w = fbo->w,
+        .h = fbo->h,
+        .format = fbo->format,
+        .usage = fbo->usage,
+        .tex = tex,
+    };
+    return t;
+}
+
+// Look the image up (or wrap it) and release it to libplacebo with the API
+// user's acquire wait. From here on the image is libplacebo's until
+// hold_target() hands it back.
+static int acquire_target(struct libmpv_gpu_context *ctx, const mpv_vulkan_fbo *fbo,
+                          struct target **out_t, struct ra_tex *out_ratex)
+{
+    struct priv *p = ctx->priv;
+    if (!sync_valid(ctx, fbo))
+        return MPV_ERROR_INVALID_PARAMETER;
+    struct target *t = find_target(ctx, fbo);
+    if (!t)
+        return MPV_ERROR_UNSUPPORTED;
+    if (!mppl_wrap_tex(ctx->ra_ctx->ra, t->tex, out_ratex)) {
+        MP_ERR(ctx, "The Vulkan target format has no mpv equivalent.\n");
+        forget_target(ctx, t);
+        return MPV_ERROR_UNSUPPORTED;
+    }
+    pl_vulkan_release_ex(p->vk->gpu, pl_vulkan_release_params(
+        .tex = t->tex,
+        .layout = fbo->layout,
+        .qf = fbo->queue_family,
+        .semaphore = {
+            .sem = fbo->acquire_semaphore,
+            .value = fbo->acquire_value,
+        },
+    ));
+    t->last_used = ++p->frame_count;
+    *out_t = t;
+    return 0;
+}
+
+static int wrap_fbo(struct libmpv_gpu_context *ctx, mpv_render_param *params,
+                    struct ra_tex **out)
+{
+    struct priv *p = ctx->priv;
+    mpv_vulkan_fbo *fbo = get_mpv_render_param(params, MPV_RENDER_PARAM_VULKAN_FBO, NULL);
+    if (!fbo_valid(fbo))
+        return MPV_ERROR_INVALID_PARAMETER;
+    assert(!p->cur);
+    struct target *t;
+    int err = acquire_target(ctx, fbo, &t, &p->cur_ratex);
+    if (err < 0)
+        return err;
+    p->cur = t;
+    p->cur_fbo = *fbo;
+    *out = &p->cur_ratex;
+    return 0;
+}
+
+static int wrap_overlay(struct libmpv_gpu_context *ctx, mpv_render_param *params,
+                        struct ra_tex **out)
+{
+    struct priv *p = ctx->priv;
+    mpv_vulkan_overlay_fbo *ov =
+        get_mpv_render_param(params, MPV_RENDER_PARAM_VULKAN_OVERLAY_FBO, NULL);
+    assert(ov && !p->cur_ovl);
+    struct target *t;
+    int err = acquire_target(ctx, &ov->target, &t, &p->cur_ovl_ratex);
+    if (err < 0)
+        return err;
+    p->cur_ovl = t;
+    p->cur_ovl_fbo = ov->target;
+    *out = &p->cur_ovl_ratex;
+    return 0;
+}
+
+// Hand an acquired image back: transition, release signal, error check.
+static int hold_target(struct libmpv_gpu_context *ctx, struct target *t,
+                       const mpv_vulkan_fbo *fbo, bool ok)
+{
+    struct priv *p = ctx->priv;
+    bool held = pl_vulkan_hold_ex(p->vk->gpu, pl_vulkan_hold_params(
+        .tex = t->tex,
+        .layout = fbo->final_layout,
+        .qf = fbo->queue_family,
+        .semaphore = {
+            .sem = fbo->release_semaphore,
+            .value = fbo->release_value,
+        },
+    ));
+    if (held) {
+        t->release_sem = fbo->release_semaphore;
+        t->release_value = fbo->release_value;
+    } else {
+        MP_ERR(ctx, "Failed to hand the Vulkan target back.\n");
+    }
+    if (pl_gpu_is_failed(p->vk->gpu)) {
+        MP_ERR(ctx, "The Vulkan device is lost.\n");
+        return MPV_ERROR_GENERIC;
+    }
+    return held && ok ? 0 : MPV_ERROR_GENERIC;
+}
+
+static int finish_frame(struct libmpv_gpu_context *ctx, bool ds, bool ok)
+{
+    struct priv *p = ctx->priv;
+    struct target *t = p->cur;
+    if (!t)
+        return MPV_ERROR_GENERIC;
+    p->cur = NULL;
+    return hold_target(ctx, t, &p->cur_fbo, ok);
+}
+
+static int finish_overlay(struct libmpv_gpu_context *ctx, bool ok)
+{
+    struct priv *p = ctx->priv;
+    struct target *t = p->cur_ovl;
+    if (!t)
+        return MPV_ERROR_GENERIC;
+    p->cur_ovl = NULL;
+    return hold_target(ctx, t, &p->cur_ovl_fbo, ok);
+}
+
+static void overlay_result(struct libmpv_gpu_context *ctx, mpv_render_param *params,
+                           bool rendered, const struct mp_rect *src,
+                           const struct mp_rect *dst)
+{
+    mpv_vulkan_overlay_fbo *ov =
+        get_mpv_render_param(params, MPV_RENDER_PARAM_VULKAN_OVERLAY_FBO, NULL);
+    if (!ov)
+        return;
+    ov->rendered = rendered;
+    ov->video_rect[0] = dst->x0;
+    ov->video_rect[1] = dst->y0;
+    ov->video_rect[2] = dst->x1;
+    ov->video_rect[3] = dst->y1;
+    ov->source_rect[0] = src->x0;
+    ov->source_rect[1] = src->y0;
+    ov->source_rect[2] = src->x1;
+    ov->source_rect[3] = src->y1;
+}
+
+static void done_frame(struct libmpv_gpu_context *ctx, bool ds)
+{
+    finish_frame(ctx, ds, true);
+}
+
+// After pl_gpu_finish(), wait until the last release signal of every target
+// being retired is visible. Measured on MoltenVK 1.4.2: pl_gpu_finish() can
+// return while a release value submitted with mpv's last frame is not yet
+// visible through vkGetSemaphoreCounterValue (1-4 ms later). An API user
+// that frees or reuses the image right after retirement must be able to rely
+// on the release having happened.
+static void wait_released(struct libmpv_gpu_context *ctx, VkImage image)
+{
+    struct priv *p = ctx->priv;
+    for (int n = 0; n < MAX_TARGETS; n++) {
+        struct target *t = &p->targets[n];
+        if (!t->tex || !t->release_sem || (image && t->image != image))
+            continue;
+        uint64_t v = 0;
+        if (p->GetSemaphoreCounterValue(p->device, t->release_sem, &v) == VK_SUCCESS &&
+            v >= t->release_value)
+            continue;
+        int64_t start = mp_time_ns();
+        VkSemaphoreWaitInfo wi = {
+            .sType = VK_STRUCTURE_TYPE_SEMAPHORE_WAIT_INFO,
+            .semaphoreCount = 1,
+            .pSemaphores = &t->release_sem,
+            .pValues = &t->release_value,
+        };
+        // Bounded: the signal was submitted after mpv's own work, so it can
+        // only be missing if the device is lost.
+        VkResult res = p->WaitSemaphores(p->device, &wi, UINT64_C(2000000000));
+        MP_VERBOSE(ctx, "Retire: release %llu of an image came %.2f ms after "
+                   "the GPU went idle (%s).\n", (unsigned long long)t->release_value,
+                   (mp_time_ns() - start) / 1e6, res == VK_SUCCESS ? "ok" : "timeout");
+    }
+}
+
+static int set_parameter(struct libmpv_gpu_context *ctx, mpv_render_param param)
+{
+    struct priv *p = ctx->priv;
+
+    switch ((int)param.type) {
+    case MPV_RENDER_PARAM_VULKAN_RETIRE: {
+        VkImage image = param.data ? *(VkImage *)param.data : VK_NULL_HANDLE;
+        pl_gpu_finish(p->vk->gpu);
+        wait_released(ctx, image);
+        for (int n = 0; n < MAX_TARGETS; n++) {
+            struct target *t = &p->targets[n];
+            if (t->tex && (!image || t->image == image))
+                forget_target(ctx, t);
+        }
+        return 0;
+    }
+    default:
+        return MPV_ERROR_NOT_IMPLEMENTED;
+    }
+}
+
+static void destroy(struct libmpv_gpu_context *ctx)
+{
+    struct priv *p = ctx->priv;
+    if (!p)
+        return;
+
+    if (p->vk) {
+        pl_gpu_finish(p->vk->gpu);
+        for (int n = 0; n < MAX_TARGETS; n++)
+            forget_target(ctx, &p->targets[n]);
+    }
+    if (ctx->ra_ctx && ctx->ra_ctx->ra) {
+        ctx->ra_ctx->ra->fns->destroy(ctx->ra_ctx->ra);
+        ctx->ra_ctx->ra = NULL;
+    }
+    // Leaves the API user's device intact.
+    pl_vulkan_destroy(&p->vk);
+    pl_log_destroy(&p->pllog);
+}
+
+const struct libmpv_gpu_context_fns libmpv_gpu_context_vulkan = {
+    .api_name        = MPV_RENDER_API_TYPE_VULKAN,
+    .gpu_next_only   = true,
+    .init            = init,
+    .get_target_size = get_target_size,
+    .wrap_fbo        = wrap_fbo,
+    .done_frame      = done_frame,
+    .finish_frame    = finish_frame,
+    .set_parameter   = set_parameter,
+    .overlay_size    = overlay_size,
+    .wrap_overlay    = wrap_overlay,
+    .finish_overlay  = finish_overlay,
+    .overlay_result  = overlay_result,
+    .destroy         = destroy,
+};
