+        MP_ERR(ctx, "Overlay texture was not created with D3D11_BIND_RENDER_TARGET\n");
+        ra_tex_free(ctx->ra_ctx->ra, &p->wrapped_overlay);
+        return MPV_ERROR_INVALID_PARAMETER;
+    }
+
+    *out = p->wrapped_overlay;
+    return 0;
+}
