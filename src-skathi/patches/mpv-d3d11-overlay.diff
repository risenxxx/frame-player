+void mppl_video_set_overlay_target(struct mppl_video *p,
+                                   struct mppl_video_overlay_target *target)
+{
+    p->overlay_target = target;
+}
+
+// The OSD of this frame for the overlay target: laid out for its layout size
+// with the margins of the picture's layout scaled to it, and moved so that
+// the texture's corner is the origin. Fills in bbox, and rendered with 0
+// (nothing to draw), 2 (what the texture already holds) or 1 (to be drawn).
+static void update_overlay_target(struct mppl_video *p, struct vo_frame *frame,
+                                  const struct pl_swapchain_frame *swframe,
+                                  int flags, struct pl_frame *out)
+{
+    struct mppl_video_overlay_target *ot = p->overlay_target;
+    float sx = ot->layout_w / (float)swframe->fbo->params.w;
+    float sy = ot->layout_h / (float)swframe->fbo->params.h;
+    struct mp_osd_res res = p->osd_res;
+    res.w = ot->layout_w;
+    res.h = ot->layout_h;
+    res.ml = lrintf(res.ml * sx);
+    res.mr = lrintf(res.mr * sx);
+    res.mt = lrintf(res.mt * sy);
+    res.mb = lrintf(res.mb * sy);
+
+    float ref_luma = get_ref_luma(p);
+    if (ot->fbo) {
+        int depth = ot->fbo->params.format->component_depth[0];
+        pl_frame_from_swapchain(out, &(struct pl_swapchain_frame) {
+            .fbo = ot->fbo,
+            .color_repr = {
+                .sys = PL_COLOR_SYSTEM_RGB,
+                .levels = PL_COLOR_LEVELS_FULL,
+                .alpha = PL_ALPHA_PREMULTIPLIED,
+                .bits = { .sample_depth = depth, .color_depth = depth },
+            },
+            .color_space = pl_color_space_srgb,
+        });
+        // What update_overlays() gives SDR overlays: no mapping between the two.
+        if (ref_luma)
+            out->color.hdr.max_luma = ref_luma;
+    }
+
+    update_overlays(p, res, flags, PL_OVERLAY_COORDS_DST_FRAME, &p->osd_state,
+                    out, frame->current,
+                    frame->current ? frame->current->params.stereo3d : 0, ref_luma);
+
+    int bbox[4] = { INT_MAX, INT_MAX, INT_MIN, INT_MIN };
+    int parts = 0;
+    for (int n = 0; n < out->num_overlays; n++) {
+        const struct pl_overlay *ol = &out->overlays[n];
+        for (int i = 0; i < ol->num_parts; i++) {
+            struct pl_overlay_part *part = (struct pl_overlay_part *)&ol->parts[i];
+            bbox[0] = MPMIN(bbox[0], (int)floorf(part->dst.x0));
+            bbox[1] = MPMIN(bbox[1], (int)floorf(part->dst.y0));
+            bbox[2] = MPMAX(bbox[2], (int)ceilf(part->dst.x1));
+            bbox[3] = MPMAX(bbox[3], (int)ceilf(part->dst.y1));
+            part->dst.x0 -= ot->offset_x;
+            part->dst.x1 -= ot->offset_x;
+            part->dst.y0 -= ot->offset_y;
+            part->dst.y1 -= ot->offset_y;
+            parts++;
+        }
+    }
+    if (!parts) {
+        out->num_overlays = 0;
+        ot->rendered = 0;
+        memset(ot->bbox, 0, sizeof(ot->bbox));
+        p->overlay_signature = 0;
+        return;
+    }
+    memcpy(ot->bbox, bbox, sizeof(bbox));
+    if (!ot->fbo) {
+        // Something to draw and nothing to draw it into.
+        ot->rendered = 3;
+        p->overlay_signature = 0;
+        return;
+    }
+
+    uint64_t sig = p->osd_state.signature;
+    const uint64_t more[] = {
+        res.w, res.h, res.ml, res.mr, res.mt, res.mb, ot->offset_x, ot->offset_y,
+        ot->fbo->params.w, ot->fbo->params.h, (uint64_t)(ref_luma * 16),
+    };
+    for (int i = 0; i < MP_ARRAY_SIZE(more); i++)
+        sig = (sig ^ more[i]) * 0x100000001b3ull;
+    sig |= 1; // never 0, which stands for "nothing drawn"
+    ot->rendered = (!ot->force && sig == p->overlay_signature) ? 2 : 1;
+    p->overlay_signature = sig;
+}
