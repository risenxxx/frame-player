+        ra_tex_free(ctx->ra_ctx->ra, &p->wrapped_overlay);
         // ra_d3d11 frees its own struct from inside its destroy callback.
         ctx->ra_ctx->ra->fns->destroy(ctx->ra_ctx->ra);
         ctx->ra_ctx->ra = NULL;
@@ -96,6 +132,7 @@ const struct libmpv_gpu_context_fns libmpv_gpu_context_d3d11 = {
