+    *out = NULL;
+    *par = NULL;
+    mpv_d3d11_overlay_fbo *fbo =
+        get_mpv_render_param(params, MPV_RENDER_PARAM_D3D11_OVERLAY_FBO, NULL);
+    if (!fbo)
