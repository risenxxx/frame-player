+/**
+ * For MPV_RENDER_PARAM_D3D11_OVERLAY_FBO (not in upstream mpv).
+ *
+ * The picture goes to MPV_RENDER_PARAM_D3D11_FBO without subtitles and OSD;
+ * they are laid out for layout_w x layout_h pixels, with the margins of the
+ * picture's layout scaled to that size, and drawn into tex, which shows the
+ * layout from (offset_x, offset_y) on. A picture target smaller than the
+ * element it is shown in can so be paired with text at the element's size.
+ * Subtitles blended into the video (blend-subtitles) stay in the picture.
+ */
+typedef struct mpv_d3d11_overlay_fbo {
+    /**
+     * sizeof(mpv_d3d11_overlay_fbo), for later fields.
+     */
+    size_t struct_size;
+    /**
+     * The texture to draw into, with the requirements of mpv_d3d11_fbo.tex and
+     * an alpha channel. When something is drawn the whole texture is first
+     * cleared to transparent; the result has premultiplied alpha and sRGB
+     * encoded values (BT.709 primaries), whatever the picture's target is.
+     *
+     * NULL: nothing is drawn, the picture still comes without subtitles and
+     * OSD, and rendered says whether there was something to draw (3) or not
+     * (0). layout_w and layout_h are required then. A producer can so keep no
+     * texture while there are no subtitles.
+     *
+     * Type: ID3D11Texture2D*
+     */
+    void *tex;
+    /**
+     * The size subtitles and OSD are laid out for; 0 means the texture's.
+     */
+    int layout_w, layout_h;
+    /**
+     * Where the texture's top left corner is in that layout.
+     */
+    int offset_x, offset_y;
+    /**
+     * Set to 1 to draw even when nothing changed since the last render with
+     * this parameter (a new texture, or one something else wrote to).
+     */
+    int force;
+    /**
+     * Out. 0: there is nothing to draw, the texture was not touched. 1: drawn.
+     * 2: the same as the last time it was drawn, the texture was not touched.
+     * 3: there is something to draw and tex is NULL.
+     * Set the field to -1 before the call to tell a libmpv that ignores the
+     * parameter from one that had nothing to draw.
+     */
+    int rendered;
+    /**
+     * Out, when rendered is not 0: x0, y0, x1, y1 of everything drawn, in
+     * layout pixels, including what fell outside the texture.
+     */
+    int bbox[4];
+} mpv_d3d11_overlay_fbo;
+
 #ifdef __cplusplus
 }
 #endif
