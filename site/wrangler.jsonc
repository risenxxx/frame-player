{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "frame-player-site",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "frameplayer.app", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": true
}
