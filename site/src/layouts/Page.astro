---
import { existsSync } from 'node:fs'
import { resolve } from 'node:path'
import onestLatin from '@fontsource-variable/onest/files/onest-latin-wght-normal.woff2?url'
import onestCyrillic from '@fontsource-variable/onest/files/onest-cyrillic-wght-normal.woff2?url'
import Analytics from '../components/Analytics.astro'
import { downloads } from '../release.ts'
import { LOCALE_META, alternatesOf, enabledLocales, multilingual, useLocale, type Locale } from '../i18n/index.ts'
import { pagesIn } from '../i18n/pages.ts'
import { checkMockStrings } from '../i18n/app.ts'
import '@fontsource-variable/onest'
import '@fontsource-variable/jetbrains-mono'
import '../styles/tokens.css'
import '../styles/base.css'
import '../styles/chrome.css'
import '../styles/player.css'
import '../styles/mocks.css'
import '../styles/sections.css'
import '../styles/prose.css'
import '../styles/narrow.css'
import '../styles/motion.css'

interface Props {
  title?: string
  description?: string
  /** `article` for a guide or a comparison, `website` for the home page. */
  ogType?: 'website' | 'article'
  /** The link card, as a path under `public/`, and what is written on it. */
  image?: string
  imageAlt?: string
  /** Structured data this page adds to the application's own record. */
  schema?: Record<string, unknown>[]
  /** The page's Markdown twin, for anything that would rather read than render. */
  markdown?: string
  /** An Atom feed of what this page lists, for a reader that would rather be told. */
  feed?: { href: string; title: string }
  /** The 404: no canonical address, and nothing for a search engine to keep. */
  noindex?: boolean
}

const { lang, s, meta, href } = useLocale(Astro)

/* Once per build: every mock's labels are the application's (i18n/app.ts). */
checkMockStrings()

/* The site's link card in the page's language, where `bun run og` has drawn
   one (`og-ru.png`); the English one otherwise. Resolved against the working
   directory, as release.ts explains. */
const localCard = `/og-${lang}.png`
const ogCard = lang !== 'en' && existsSync(resolve(process.cwd(), 'public', localCard.slice(1))) ? localCard : '/og.png'

const {
  title = s.meta.title,
  description = s.meta.description,
  ogType = 'website',
  image = ogCard,
  imageAlt = s.meta.imageAlt,
  schema = [],
  markdown,
  feed,
  noindex = false,
} = Astro.props

/*
  With `build.format: 'file'` a page is rendered as `torrent-streaming.html`,
  and `Astro.url` says so; the address it is served at has no extension.
*/
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, ''), Astro.site)

/*
  The same page in the other languages it is written in — every one of them,
  this one included, as the convention asks, and English again as the default
  for a reader whose language is none of them. A page in one language prints
  none of this, and neither does the 404, which is not a page to send anyone to.
*/
const alternates = Object.entries(alternatesOf(Astro.url.pathname)) as [Locale, string][]
const hreflang = !noindex && alternates.length > 1
  ? [
      ...alternates.map(([l, path]) => ({ hreflang: LOCALE_META[l].hreflang, href: new URL(path, Astro.site).href })),
      { hreflang: 'x-default', href: new URL(alternates.find(([l]) => l === 'en')?.[1] ?? '/', Astro.site).href },
    ]
  : []
const ogImage = new URL(image, Astro.site)
const { version, windows, date } = await downloads()

/*
  One structured record for the one thing every page is about. `SoftwareApplication`
  is what a search engine reads to show a price, a platform and a rating slot; the
  offer is free rather than absent, which is a different claim. Its `url` is the
  home page wherever it is printed: a guide is about the player, it is not the
  player. A page with more to say — an article, its breadcrumbs — adds records
  beside this one rather than replacing it.
*/
/* The guides, so the application's own record points at the pages that explain
   it: one place an agent can read the whole site's shape from. */
const guides = await pagesIn(lang)

const site = new URL('/', Astro.site).href
const ORG = { '@type': 'Organization', name: 'Frame Player', url: site, logo: new URL('/apple-touch-icon.png', Astro.site).href }

const app = {
  '@type': 'SoftwareApplication',
  '@id': `${site}#app`,
  name: 'Frame Player',
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'Windows 10, Windows 11, macOS',
  softwareVersion: version,
  /* When this version was published — the one date the application itself has,
     and what says the page is current rather than merely undated. */
  ...(date ? { datePublished: date, dateModified: date } : {}),
  url: site,
  inLanguage: meta.hreflang,
  author: ORG,
  publisher: ORG,
  softwareHelp: guides.map((g) => ({ '@type': 'WebPage', name: g.data.short, url: new URL(`/${g.id}`, Astro.site).href })),
  downloadUrl: new URL(windows, Astro.site).href,
  license: 'https://www.gnu.org/licenses/gpl-3.0.html',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  image: new URL('/og.png', Astro.site).href,
  description: s.meta.description,
}
/* The site itself, so a page, its guides and the application are one graph
   rather than three records that happen to share a domain. */
const website = {
  '@type': 'WebSite',
  '@id': `${site}#website`,
  name: 'Frame Player',
  url: site,
  inLanguage: multilingual() ? enabledLocales().map((l) => LOCALE_META[l].hreflang) : meta.hreflang,
  publisher: ORG,
  about: { '@id': `${site}#app` },
}

const jsonLd = { '@context': 'https://schema.org', '@graph': [website, app, ...schema] }
---

<!doctype html>
<html lang={meta.htmlLang} data-lang={multilingual() ? lang : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        {/* Nothing withheld from a snippet: a page that means to be quoted says so. */}
        <meta name="robots" content="max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
        {hreflang.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
        {markdown && <link rel="alternate" type="text/markdown" href={new URL(markdown, Astro.site)} />}
        {feed && <link rel="alternate" type="application/atom+xml" title={feed.title} href={new URL(feed.href, Astro.site)} />}
      </>
    )}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Frame Player" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={meta.ogLocale} />
    {hreflang.length > 0 && alternates.filter(([l]) => l !== lang).map(([l]) => <meta property="og:locale:alternate" content={LOCALE_META[l].ogLocale} />)}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#08090C" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {/* The faces the first screen is set in, so it is not drawn twice. Every
        language has Latin in it (the name, the platforms); Russian adds its
        letters; Chinese takes its Han from the system and preloads nothing more. */}
    <link rel="preload" href={onestLatin} as="font" type="font/woff2" crossorigin />
    {lang === 'ru' && <link rel="preload" href={onestCyrillic} as="font" type="font/woff2" crossorigin />}

    {/*
      The only script in the head, and it runs before the first paint: it marks
      the document as scripted (without JS every scene stays at its finished
      state) and applies an explicitly chosen theme, or the page flashes the
      system one while the module that owns the switch is still loading.

      It also parks the scenes at their start (`scenes`, see motion.css), under
      the same two conditions motion.ts plays them on. The module is deferred,
      so parking them from there left the first frames showing each scene
      finished — the hero's interface was visible, then vanished, then faded
      in. The watchdog is the other half of motion.ts's own rule that what
      hides the page must be what brings it back: if the module never got as
      far as starting (`reveal` is its first act), the scenes are released to
      their finished state rather than left empty.
    */}
    <script is:inline>
      document.documentElement.classList.add('js')
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        const root = document.documentElement
        root.classList.add('scenes')
        setTimeout(() => { if (!root.classList.contains('reveal')) root.classList.remove('scenes') }, 5000)
      }
      // Which download is the primary one (base.css). An iPad reports itself
      // as a Mac, which is the right answer for a visitor on Apple hardware.
      const platform = (navigator.userAgentData && navigator.userAgentData.platform) || navigator.platform || navigator.userAgent
      if (/mac|iphone|ipad|ipod/i.test(platform)) document.documentElement.dataset.os = 'macos'
      // Which installer the header's Download button hands over (chrome.css).
      // Only a desktop that can run one: an iPad passes the Mac test above with
      // a touch screen, and anything else keeps the link to the download block.
      if (/win/i.test(platform)) document.documentElement.dataset.dl = 'windows'
      else if (/mac/i.test(platform) && navigator.maxTouchPoints < 2) document.documentElement.dataset.dl = 'macos'
      try {
        const theme = localStorage.getItem('fp-theme')
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme
      } catch {}
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <Analytics />
  </head>
  <body>
    <slot />
  </body>
</html>
