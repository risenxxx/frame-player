---
import onestLatin from '@fontsource-variable/onest/files/onest-latin-wght-normal.woff2?url'
import { downloads } from '../release.ts'
import '@fontsource-variable/onest'
import '@fontsource-variable/jetbrains-mono'
import '../styles/tokens.css'
import '../styles/base.css'
import '../styles/chrome.css'
import '../styles/player.css'
import '../styles/mocks.css'
import '../styles/sections.css'
import '../styles/prose.css'
import '../styles/narrow.css'
import '../styles/motion.css'

interface Props {
  title?: string
  description?: string
  /** `article` for a guide or a comparison, `website` for the home page. */
  ogType?: 'website' | 'article'
  /** The link card, as a path under `public/`, and what is written on it. */
  image?: string
  imageAlt?: string
  /** Structured data this page adds to the application's own record. */
  schema?: Record<string, unknown>[]
  /** The 404: no canonical address, and nothing for a search engine to keep. */
  noindex?: boolean
}

const {
  title = 'Frame Player — a video player for Windows and macOS',
  description =
    'Free, open-source video player on mpv for Windows and macOS: watch a torrent as it downloads, ' +
    'cast to the TV untouched, resume anything.',
  ogType = 'website',
  image = '/og.png',
  imageAlt = 'Frame Player: files, links, magnets. One player that gets them right.',
  schema = [],
  noindex = false,
} = Astro.props

/*
  With `build.format: 'file'` a page is rendered as `torrent-streaming.html`,
  and `Astro.url` says so; the address it is served at has no extension.
*/
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, ''), Astro.site)
const ogImage = new URL(image, Astro.site)
const { version, windows } = await downloads()

/*
  One structured record for the one thing every page is about. `SoftwareApplication`
  is what a search engine reads to show a price, a platform and a rating slot; the
  offer is free rather than absent, which is a different claim. Its `url` is the
  home page wherever it is printed: a guide is about the player, it is not the
  player. A page with more to say — an article, its breadcrumbs — adds records
  beside this one rather than replacing it.
*/
const app = {
  '@type': 'SoftwareApplication',
  name: 'Frame Player',
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'Windows 10, Windows 11, macOS',
  softwareVersion: version,
  url: new URL('/', Astro.site).href,
  downloadUrl: new URL(windows, Astro.site).href,
  license: 'https://www.gnu.org/licenses/gpl-3.0.html',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  image: new URL('/og.png', Astro.site).href,
  description:
    'Free, open-source video player on mpv for Windows and macOS: watch a torrent as it downloads, ' +
    'cast to the TV untouched, resume anything.',
}
const jsonLd = { '@context': 'https://schema.org', '@graph': [app, ...schema] }
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Frame Player" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#08090C" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={onestLatin} as="font" type="font/woff2" crossorigin />

    {/*
      The only script in the head, and it runs before the first paint: it marks
      the document as scripted (without JS every scene stays at its finished
      state) and applies an explicitly chosen theme, or the page flashes the
      system one while the module that owns the switch is still loading.

      It also parks the scenes at their start (`scenes`, see motion.css), under
      the same two conditions motion.ts plays them on. The module is deferred,
      so parking them from there left the first frames showing each scene
      finished — the hero's interface was visible, then vanished, then faded
      in. The watchdog is the other half of motion.ts's own rule that what
      hides the page must be what brings it back: if the module never got as
      far as starting (`reveal` is its first act), the scenes are released to
      their finished state rather than left empty.
    */}
    <script is:inline>
      document.documentElement.classList.add('js')
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        const root = document.documentElement
        root.classList.add('scenes')
        setTimeout(() => { if (!root.classList.contains('reveal')) root.classList.remove('scenes') }, 5000)
      }
      try {
        const theme = localStorage.getItem('fp-theme')
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme
      } catch {}
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>
