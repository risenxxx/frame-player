---
/*
  Every page of the `pages` collection, at the address its file names:
  `src/content/pages/compare/iina.mdx` is `/compare/iina`, and its Russian
  translation `ru/compare/iina.mdx` is `/ru/compare/iina` — a translation of a
  language this build does not carry is left out (src/i18n/pages.ts). The home
  page, the 404 and the sitemap are files of their own and win over this route.
*/
import { render } from 'astro:content'
import Article from '../layouts/Article.astro'
import Table from '../components/prose/Table.astro'
import { allPages } from '../i18n/pages.ts'

export async function getStaticPaths() {
  const pages = await allPages()
  return pages.map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
}

const { entry } = Astro.props
const { Content } = await render(entry)
---

<Article entry={entry}>
  <Content components={{ table: Table }} />
</Article>
