---
import Page from '../layouts/Page.astro'
import Icons from '../components/Icons.astro'
import Nav from '../components/Nav.astro'
import Hero from '../components/Hero.astro'
import OpenAnything from '../components/OpenAnything.astro'
import Torrents from '../components/Torrents.astro'
import Television from '../components/Television.astro'
import Together from '../components/Together.astro'
import Subtitles from '../components/Subtitles.astro'
import Catalog from '../components/Catalog.astro'
import StartScreen from '../components/StartScreen.astro'
import Picture from '../components/Picture.astro'
import MoreGrid from '../components/MoreGrid.astro'
import Faq from '../components/Faq.astro'
import Updates from '../components/Updates.astro'
import FinalCta from '../components/FinalCta.astro'
import Footer from '../components/Footer.astro'
import { FAQ } from '../faq.ts'

const faqPage = {
  '@type': 'FAQPage',
  mainEntity: FAQ.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
}
---

<Page schema={[faqPage]}>
  <Icons />
  <Nav />
  <main id="top">
    <Hero />
    <OpenAnything />
    <Torrents />
    <Television />
    <Together />
    <Subtitles />
    <Catalog />
    <StartScreen />
    <Picture />
    <MoreGrid />
    <Faq />
    <Updates />
    <FinalCta />
  </main>
  <Footer />

  <script>
    import { initTheme } from '../scripts/theme.ts'
    import { initMotion } from '../scripts/motion.ts'
    import { initNav } from '../scripts/nav.ts'
    import { initPointer } from '../scripts/pointer.ts'
    import { initDownload } from '../scripts/download.ts'
    import { initCastWalk } from '../scripts/castwalk.ts'

    initTheme()
    initNav()
    initPointer()
    initDownload()
    initCastWalk()
    initMotion()
  </script>
</Page>
