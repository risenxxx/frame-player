---
import T from '../i18n/T.astro'
import { useLocale } from '../i18n/index.ts'

const { s } = useLocale(Astro)

/* Each cell's glyph, by position: the dictionary's cells are in this order. */
const ICONS = ['i-play', 'i-conf', 'i-pip', 'i-search', 'i-skip', 'i-pip', 'i-keys', 'i-hdr', 'i-loop', 'i-zoom', 'i-frame', 'i-audio', 'i-queue', 'i-shield', 'i-conf']
if (ICONS.length !== s.everything.cells.length) throw new Error('MoreGrid: one icon per cell')
---

  <section class="more" id="everything">
    <div class="wrap">
      <div class="sec-h" data-reveal>
        <h2><T s={s.everything.h} /></h2>
        <p class="lede">
          <T s={s.everything.lede} />
        </p>
      </div>
      <div class="grid" data-reveal style="--dl:1">
        {s.everything.cells.map((cell, i) => (
          <div class="cell">
            <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href={`#${ICONS[i]}`}/></svg>
            <h3><T s={cell.h} /></h3>
            <p><T s={cell.p} /></p>
          </div>
        ))}
        <div class="cell spare" aria-hidden="true">
          <p><T s={s.everything.spare} /></p>
        </div>
      </div>
    </div>
  </section>
