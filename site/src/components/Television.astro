---
import CastMock from './mocks/CastMock.astro'
import T from '../i18n/T.astro'
import { useLocale } from '../i18n/index.ts'

const { s, href } = useLocale(Astro)
---

  <section class="feat sc-cast" id="tv">
    <div class="wrap feat-in">
      <div class="feat-copy" data-reveal>
        <h2><T s={s.tv.h} /></h2>
        <p class="lede">
          <T s={s.tv.lede} />
        </p>
        <ul class="checks">
          {s.tv.checks.map((check) => (
            <li><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-check"/></svg>
            <span><T s={check} /></span></li>
          ))}
        </ul>
        <a class="more-link" href={href('/cast-to-tv')}><T s={s.tv.more} /></a>
      </div>
      <div class="feat-mock" data-reveal style="--dl:1">
        <CastMock />
      </div>
    </div>
  </section>
