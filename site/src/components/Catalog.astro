---
import TitleBar from './mocks/TitleBar.astro'
import Frame from './Frame.astro'
import T from '../i18n/T.astro'
import { useLocale } from '../i18n/index.ts'

const { s } = useLocale(Astro)
---

  <section class="feat rev" id="catalog">
    <div class="wrap feat-in">
      <div class="feat-copy" data-reveal>
        <h2><T s={s.catalog.h} /></h2>
        <p class="lede">
          <T s={s.catalog.lede} />
        </p>
        <ul class="checks">
          {s.catalog.checks.map((check) => (
            <li><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-check"/></svg>
            <span><T s={check} /></span></li>
          ))}
        </ul>
      </div>
      <div class="feat-mock" data-reveal style="--dl:1">
        <div class="win" data-scene data-dur="3000" aria-hidden="true">
          <TitleBar><T s={s.mock.catalog.title} /><span class="sep"></span><T s={s.mock.catalog.year} p={{ title: s.mock.catalog.posters[0]!, year: 2024 }} /></TitleBar>
          <div class="posters">
            <span class="poster sel" style="--i:0"><Frame name="poster-dust-lines" slot="poster" alt="" /><span class="pt"><T s={s.mock.catalog.posters[0]!} /></span></span>
            <span class="poster" style="--i:1"><Frame name="poster-wet-season" slot="poster" alt="" /><span class="pt"><T s={s.mock.catalog.posters[1]!} /></span></span>
            <span class="poster" style="--i:2"><Frame name="poster-night-shift" slot="poster" alt="" /><span class="pt"><T s={s.mock.catalog.posters[2]!} /></span></span>
            <span class="poster" style="--i:3"><Frame name="poster-the-crossing" slot="poster" alt="" /><span class="pt"><T s={s.mock.catalog.posters[3]!} /></span></span>
          </div>
          <div class="rel">
            <div class="rel-row" style="--i:0"><span class="q hdr">2160p HDR</span><span class="nm">WEB-DL<span class="sep"></span>DV/HDR10<span class="sep"></span>E-AC-3 5.1</span><span class="seed">214<svg class="ic stat" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-up"/></svg></span></div>
            <div class="rel-row" style="--i:1"><span class="q">2160p</span><span class="nm">WEB-DL<span class="sep"></span>SDR<span class="sep"></span>AAC 5.1</span><span class="seed">96<svg class="ic stat" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-up"/></svg></span></div>
            <div class="rel-row" style="--i:2"><span class="q">1080p</span><span class="nm">BDRip<span class="sep"></span>x264<span class="sep"></span><T s={s.mock.catalog.dubs} /></span><span class="seed">431<svg class="ic stat" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-up"/></svg></span></div>
          </div>
        </div>
      </div>
    </div>
  </section>
