---
import PictureMock from './mocks/PictureMock.astro'
import T from '../i18n/T.astro'
import { useLocale } from '../i18n/index.ts'

const { s, href } = useLocale(Astro)
---

  <section class="feat rev mock-wide" id="picture">
    <div class="wrap feat-in">
      <div class="feat-copy" data-reveal>
        <h2><T s={s.picture.h} /></h2>
        <p class="lede">
          <T s={s.picture.lede} />
        </p>
        <ul class="checks">
          {s.picture.checks.map((check) => (
            <li><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-check"/></svg>
            <span><T s={check} /></span></li>
          ))}
        </ul>
        <p class="more-links">
          <a class="more-link" href={href('/guides/remove-black-bars')}><T s={s.picture.more[0]!} /></a>
          <a class="more-link" href={href('/guides/darker-than-quicktime')}><T s={s.picture.more[1]!} /></a>
        </p>
      </div>
      <div class="feat-mock" data-reveal style="--dl:1">
        <PictureMock />
      </div>
    </div>
  </section>
