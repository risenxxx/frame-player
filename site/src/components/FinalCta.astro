---
import { downloads } from '../release.ts'
import T from '../i18n/T.astro'
import { useLocale } from '../i18n/index.ts'

const { version, windows, windowsArm, macos } = await downloads()
const { s } = useLocale(Astro)
---

  <section class="final">
    <div class="hero-light" aria-hidden="true" style="top:auto;bottom:-620px"></div>
    <div class="wrap" style="position:relative">
      <h2 data-reveal>{s.final.title.map((line) => <span><T s={line} /></span>)}</h2>
      <div class="cta cta-c" data-reveal style="--dl:1">
        <a class="btn btn-primary btn-lg dl-windows" href={windows} data-arm={windowsArm}>
          <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-windows"/></svg>
          <T s={s.download.windows} />
        </a>
        <a class="btn btn-ghost btn-lg dl-macos" href={macos}>
          <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-apple"/></svg>
          <T s={s.download.macos} />
        </a>
      </div>
      <div data-reveal style="--dl:2">
        <span class="brewbar">
          <span><span style="color:var(--fg3)">$</span> <b>brew install --cask risenxxx/tap/frame-player</b></span>
          <button type="button" class="brewcopy" data-copy="brew install --cask risenxxx/tap/frame-player" data-copied={s.final.copied}>
            <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-copy"/></svg>
            <span class="lbl"><T s={s.final.copy} /></span><span class="vh"><T s={s.final.copyWhat} /></span>
          </button>
        </span>
        <p class="fine facts-line mid">
          <span class="nb"><T s={s.download.version} p={{ version }} /></span><span class="sep"></span>{windowsArm && <><span class="nb"><a class="dl-arm" href={windowsArm}><T s={s.download.windowsArm} /></a></span><span class="sep"></span></>}<span class="nb"><T s={s.final.notarized} /></span><span class="sep"></span><span class="nb"><T s={s.final.unsigned} /></span>
        </p>
      </div>
    </div>
  </section>
