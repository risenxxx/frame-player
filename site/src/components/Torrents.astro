---
import TorrentMock from './mocks/TorrentMock.astro'
import T from '../i18n/T.astro'
import { useLocale } from '../i18n/index.ts'

const { s, href } = useLocale(Astro)
---

  <section class="feat rev" id="torrents">
    <div class="wrap feat-in">
      <div class="feat-copy" data-reveal>
        <h2><T s={s.torrents.h} /></h2>
        <p class="lede">
          <T s={s.torrents.lede} />
        </p>
        <ul class="checks">
          {s.torrents.checks.map((check) => (
            <li><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-check"/></svg>
            <span><T s={check} /></span></li>
          ))}
        </ul>
        <a class="more-link" href={href('/torrent-streaming')}><T s={s.torrents.more} /></a>
      </div>
      <div class="feat-mock" data-reveal style="--dl:1">
        <TorrentMock />
      </div>
    </div>
  </section>
