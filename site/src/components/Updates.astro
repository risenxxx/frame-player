---
/*
  The last three releases, on the home page: what each was about in a
  sentence, and its headlines under it. The whole list is `/updates`.

  The notes are written once, in English, by the release; on a page in another
  language they say so with `lang`, so a screen reader reads them as English
  and a translator in the browser knows what to translate.
*/
import T from '../i18n/T.astro'
import { useLocale, shortDate } from '../i18n/index.ts'
import { publishedReleases, anchor, headlines } from '../releases.ts'

const { lang, s, meta, href } = useLocale(Astro)
const notes = lang === 'en' ? undefined : 'en'
const recent = (await publishedReleases()).slice(0, 3)
---

{recent.length > 0 && (
  <section class="updates" id="updates">
    <div class="wrap">
      <div class="sec-h" data-reveal>
        <h2><T s={s.recent.h} /></h2>
        <p class="lede"><T s={s.recent.lede} /></p>
      </div>
      <ol class="upd-cards" data-reveal style="--dl:1">
        {recent.map((r) => {
          const items = headlines(r)
          return (
            <li>
              <a class="upd-card" href={href(`/updates#${anchor(r.data.version)}`)}>
                <span class="upd-k">
                  <span class="upd-v">{r.data.version}</span>
                  <time datetime={r.data.date.toISOString().slice(0, 10)}>{shortDate(lang, r.data.date)}</time>
                </span>
                <span class="upd-t" lang={notes}>{r.data.summary}</span>
                {items.length > 0 && (
                  <span class="upd-h" lang={notes}>
                    {items.slice(0, 3).map((h) => <span>{h}</span>)}
                    {items.length > 3 && <span class="upd-more" lang={notes && meta.htmlLang}><T s={s.recent.andMore} p={{ n: items.length - 3 }} /></span>}
                  </span>
                )}
              </a>
            </li>
          )
        })}
      </ol>
      <a class="more-link" href={href('/updates')} data-reveal style="--dl:2"><T s={s.recent.all} /></a>
    </div>
  </section>
)}
