---
/*
  One of the landing page's interface mocks, placed in a guide. They are the
  same components the home page draws, so a guide and the page it came from can
  never show two versions of the same panel. The cast mock reads its timing
  from `.sc-cast`, which on the home page is its section.

  The wrapper is `data-reveal`, as each mock's column is on the home page, and
  not only for the fade: `.in`, which the reveal adds, is what starts the loops
  that run for as long as the mock is on screen — the two machines cutting
  between frames, the pulse on the room's readout, the cast panel's spinner.
  Without it the room mock stood still in its guide.
*/
import TorrentMock from '../mocks/TorrentMock.astro'
import CastMock from '../mocks/CastMock.astro'
import RoomMock from '../mocks/RoomMock.astro'
import SubsMock from '../mocks/SubsMock.astro'
import PlayerMock from '../mocks/PlayerMock.astro'

interface Props {
  kind: 'torrent' | 'cast' | 'room' | 'subs' | 'playing' | 'preview' | 'audio'
}

const { kind } = Astro.props
---

<figure class:list={['fig', 'fig-mock', { 'sc-cast': kind === 'cast' }]}>
  <div class="feat-mock" data-reveal>
    {kind === 'torrent' && <TorrentMock />}
    {kind === 'cast' && <CastMock />}
    {kind === 'room' && <RoomMock />}
    {kind === 'subs' && <SubsMock />}
    {kind === 'playing' && <PlayerMock kind="torrent" />}
    {kind === 'preview' && <PlayerMock kind="preview" />}
    {kind === 'audio' && <PlayerMock kind="audio" />}
  </div>
  {Astro.slots.has('default') && <figcaption><slot /></figcaption>}
</figure>
