---
/*
  A window screenshot in a guide: `name` is the `shot-<name>.jpg` that
  tools/import-shot.mjs wrote. The caption is the default slot, so a credit
  line can carry a link.
*/
import Frame from '../Frame.astro'

interface Props {
  name: string
  alt: string
  wide?: boolean
}

const { name, alt, wide = false } = Astro.props
---

<figure class:list={['fig', 'fig-shot', { wide }]}>
  <span class="shot-img"><Frame name={`shot-${name}`} slot={wide ? 'wide' : 'text'} alt={alt} /></span>
  {Astro.slots.has('default') && <figcaption><slot /></figcaption>}
</figure>
