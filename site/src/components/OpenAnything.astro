---
import TitleBar from './mocks/TitleBar.astro'
import T from '../i18n/T.astro'
import { useLocale } from '../i18n/index.ts'

const { s } = useLocale(Astro)
---

  <section class="feat" id="open">
    <div class="wrap feat-in">
      <div class="feat-copy" data-reveal>
        <h2><T s={s.open.h} /></h2>
        <p class="lede">
          <T s={s.open.lede} />
        </p>
        <ul class="checks">
          {s.open.checks.map((check) => (
            <li><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-check"/></svg>
            <span><T s={check} /></span></li>
          ))}
        </ul>
      </div>
      <div class="feat-mock" data-reveal style="--dl:1">
        <div class="win" data-scene data-dur="3400" aria-hidden="true">
          <TitleBar><T s={s.mock.opener.title} /></TitleBar>
          <div class="opener">
            <p class="opener-h"><T s={s.mock.opener.prompt} /></p>
            <div class="field">
              <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-link"/></svg>
              <span class="typed">magnet:?xt=urn:btih:9f4c1b8e…&amp;dn=Orbital.Night.S02.2160p.HDR</span>
              <span class="go"><T s={s.mock.opener.go} /></span>
            </div>
            <div class="kinds">
              <span class="kind hot" style="--i:0">magnet:</span>
              <span class="kind hot" style="--i:1">.torrent</span>
              <span class="kind hot" style="--i:2">RSS</span>
              <span class="kind" style="--i:3">https://</span>
              <span class="kind" style="--i:4">.mkv</span>
              <span class="kind" style="--i:5">.mp4</span>
              <span class="kind" style="--i:6">.webm</span>
              <span class="kind" style="--i:7">.avi</span>
              <span class="kind" style="--i:8">…</span>
            </div>
          </div>
          <div class="rows" style="border-top:1px solid var(--line)">
            <div class="row step on" style="--i:0">
              <svg class="ic ico" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-play"/></svg>
              <span class="nm">Orbital.Night.S02E01.2160p.HDR.mkv</span><span class="meta">4.1 GB</span>
            </div>
            <div class="row step" style="--i:1">
              <svg class="ic ico" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-file"/></svg>
              <span class="nm">Orbital.Night.S02E02.2160p.HDR.mkv</span><span class="meta">4.3 GB</span>
            </div>
            <div class="row step" style="--i:2">
              <svg class="ic ico" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-file"/></svg>
              <span class="nm">Orbital.Night.S02E03.2160p.HDR.mkv</span><span class="meta">4.0 GB</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
