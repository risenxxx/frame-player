---
import { release } from '../release.ts'

const { version, windows, macos } = await release()
---

  <section class="hero">
    <div class="hero-light" aria-hidden="true"></div>
    <div class="wrap hero-copy">
      <h1 class="enter">
        <span>Files, links, magnets.</span>
        <span>One player that gets them right.</span>
      </h1>
      <p class="lede enter" style="--dl:1">
        A video player for Windows and macOS, built on mpv. Watch a torrent while it is still
        downloading, send the film to the television untouched, and hold one timeline with
        somebody who is not in the room.
      </p>
      <div class="cta cta-c enter" style="--dl:2" id="download">
        <a class="btn btn-primary btn-lg" href={windows}>
          <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-windows"/></svg>
          Download for Windows
        </a>
        <a class="btn btn-ghost btn-lg" href={macos}>
          <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-apple"/></svg>
          Download for macOS
        </a>
      </div>
      <p class="fine facts-line mid enter" style="--dl:3">
        <span class="nb">Version {version}</span><span class="sep"></span><span class="nb">Windows 10/11<span class="sep"></span>Apple Silicon</span><span class="sep"></span><span class="nb">free and open source, GPL-3.0</span>
      </p>
    </div>

    <div class="wrap shot">
      <p class="vh">
        Frame Player playing a 4K file from a torrent: a hover preview of a later scene above the
        seekbar, chapter marks along it, and a skip-intro button over the video.
      </p>
      <div class="player" data-scene data-dur="2800" style="--hover:24%" aria-hidden="true">
        <img class="scene" src="/img/orion-moon.jpg" srcset="/img/orion-moon.jpg 1x, /img/orion-moon@2x.jpg 2x" alt="A spacecraft in sunlight with the Moon beyond it" width="1120" height="840" decoding="async" fetchpriority="high">
        <span class="p-scrim"></span>
        <span class="p-bar">
          <span class="lights"><i></i><i></i><i></i></span>
          <span class="p-title">Orbital.Night.S02E04.2160p.HDR.DV.mkv</span>
          <span class="p-brand"><span>Frame Player</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-mark"/></svg>
          </span>
        </span>

        <div class="torchip">
          <span class="torchip-line">
            <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-down"/></svg>
            <span class="mono">4.2 MB/s<span class="sep"></span>28 peers</span>
          </span>
          <span class="torchip-bar"><i></i></span>
        </div>

        <span class="skip">Skip intro
          <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#p-skip"/></svg>
        </span>

        <div class="osc">
          <div class="times mono"><span>4:12</span><span>56:55</span></div>
          <div class="seekwrap">
            <div class="hovertip">
              <span class="thumb"><img src="/img/earth-aurora.jpg" srcset="/img/earth-aurora.jpg 1x, /img/earth-aurora@2x.jpg 2x" alt="Earth at night under the aurora, seen from orbit" width="560" height="372" decoding="async" fetchpriority="high"></span>
              <span class="tip-time mono">13:39</span>
              <span class="tip-chapter">Chapter 2<span class="sep"></span>The Terminator Line</span>
            </div>
            <div class="seektrack">
              <span class="buffered"></span>
              <span class="fill"></span>
              <span class="chap" style="--at:12%"></span>
              <span class="chap" style="--at:28.6%"></span>
              <span class="chap" style="--at:61%"></span>
              <span class="knob"></span>
            </div>
            <svg class="cursor" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-cursor"/></svg>
          </div>
          <div class="controls">
            <div class="cluster left">
              <span class="b"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#p-volume"/></svg></span>
              <span class="volume"><i></i><b></b></span>
              <span class="speed mono">1.25×</span>
            </div>
            <div class="cluster center">
              <span class="b"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#p-prev"/></svg></span>
              <span class="b play"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#p-play"/></svg></span>
              <span class="b"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#p-next"/></svg></span>
            </div>
            <div class="cluster right">
              <span class="b opt"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#p-loop"/></svg></span>
              <span class="b opt"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#p-queue"/></svg></span>
              <span class="b opt"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#p-audio"/></svg></span>
              <span class="b opt"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#p-subs"/></svg></span>
              <span class="b on"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#p-cast"/></svg></span>
              <span class="b"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#p-full"/></svg></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
