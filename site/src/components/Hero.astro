---
import PlayerMock from './mocks/PlayerMock.astro'
import { downloads } from '../release.ts'

const { version, windows, macos } = await downloads()
---

  <section class="hero">
    <div class="hero-light" aria-hidden="true"></div>
    <div class="wrap hero-copy">
      <h1 class="enter">
        <span>Files, links, magnets.</span>
        <span>One player that gets them right.</span>
      </h1>
      <p class="lede enter" style="--dl:1">
        A video player for Windows and macOS, built on mpv. Watch a torrent while it is still
        downloading, send the film to the television untouched, and hold one timeline with
        somebody who is not in the room.
      </p>
      <div class="cta cta-c enter" style="--dl:2" id="download">
        <a class="btn btn-primary btn-lg" href={windows}>
          <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-windows"/></svg>
          Download for Windows
        </a>
        <a class="btn btn-ghost btn-lg" href={macos}>
          <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-apple"/></svg>
          Download for macOS
        </a>
      </div>
      <p class="fine facts-line mid enter" style="--dl:3">
        <span class="nb">Version {version}</span><span class="sep"></span><span class="nb">Windows 10/11<span class="sep"></span>Apple Silicon</span><span class="sep"></span><span class="nb">free and open source, GPL-3.0</span>
      </p>
    </div>

    <div class="wrap shot">
      <p class="vh">
        Frame Player playing a 4K file from a torrent: a hover preview of a later scene above the
        seekbar, chapter marks along it, and a skip-intro button over the video.
      </p>
      <PlayerMock kind="hero" />
    </div>
  </section>
