---
import PlayerMock from './mocks/PlayerMock.astro'
import { downloads } from '../release.ts'
import { INSTALLS_BASE, installsLabel } from '../installs.ts'
import T from '../i18n/T.astro'
import { useLocale } from '../i18n/index.ts'

const { version, windows, windowsArm, macos } = await downloads()
const { lang, s } = useLocale(Astro)
---

  <section class="hero">
    <div class="hero-light" aria-hidden="true"></div>
    <div class="wrap hero-copy">
      <h1 class="enter">
        {s.hero.title.map((line) => <span><T s={line} /></span>)}
      </h1>
      <p class="lede enter" style="--dl:1">
        <T s={s.hero.lede} />
      </p>
      <div class="cta cta-c enter" style="--dl:2" id="download">
        <a class="btn btn-primary btn-lg dl-windows" href={windows} data-arm={windowsArm}>
          <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-windows"/></svg>
          <T s={s.download.windows} />
        </a>
        <a class="btn btn-ghost btn-lg dl-macos" href={macos}>
          <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-apple"/></svg>
          <T s={s.download.macos} />
        </a>
      </div>
      <p class="fine facts-line mid enter" style="--dl:3">
        <span class="nb"><T s={s.download.version} p={{ version }} /></span><span class="sep"></span><span class="nb" data-installs={s.download.installs}>{installsLabel(s.download.installs, INSTALLS_BASE, lang)}</span><span class="sep"></span><span class="nb"><T s={s.download.platforms} /></span><span class="sep"></span>{windowsArm && <><span class="nb"><a class="dl-arm" href={windowsArm}><T s={s.download.windowsArm} /></a></span><span class="sep"></span></>}<span class="nb"><T s={s.download.license} /></span>
      </p>
    </div>

    <div class="wrap shot">
      <p class="vh">
        <T s={s.hero.shot} />
      </p>
      <PlayerMock kind="hero" />
    </div>
  </section>
