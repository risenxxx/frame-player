---
/*
  The header links to sections of the home page. Written as bare fragments they
  only worked there: on any other page `#torrents` pointed into a document that
  has no such section. `/#torrents` works from everywhere, and on the home page
  itself it is still a same-document jump, not a reload. The brand goes back to
  the top of the page it is on only when that page is the home page.

  `download` is where the Download button points when the visitor's system is
  not one the player runs on: every page that carries its own download block
  (`#download`) keeps the reader where they are, and one that does not, the 404,
  sends them to the home page's. On Windows and on a Mac the button is the
  installer itself — one of three links, picked before the first paint by the
  `data-dl` the head script sets (chrome.css), so nothing has to scroll.

  In another language the same rule holds with the prefix: `/ru#torrents`, and
  the home page is `/ru`.
*/
import { downloads } from '../release.ts'
import T from '../i18n/T.astro'
import Langs from './Langs.astro'
import ThemeSwitch from './ThemeSwitch.astro'
import LangHint from './LangHint.astro'
import { useLocale } from '../i18n/index.ts'

interface Props {
  download?: string
}

const { download = '#download' } = Astro.props
const { windows, macos } = await downloads()
const { s, home, href } = useLocale(Astro)
const section = (id: string) => (home ? `#${id}` : href(`/#${id}`))
---

<!-- The marker the header watches: "the page has left the top" is an observer
     answering, not a scroll handler running beside a backdrop-filter. -->
<div class="nav-top" aria-hidden="true" data-nav-top></div>
<header class="nav" data-nav>
  <div class="wrap nav-in">
    <a class="brand" href={home ? '#top' : href('/')} aria-label={home ? s.nav.toTop : s.nav.home}>
      <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-mark"/></svg>Frame Player
    </a>
    <nav class="nav-links" aria-label={s.nav.sections}>
      <a href={section('open')}><T s={s.nav.open} /></a>
      <a href={section('torrents')}><T s={s.nav.torrents} /></a>
      <a href={section('tv')}><T s={s.nav.tv} /></a>
      <a href={section('together')}><T s={s.nav.together} /></a>
      <a href={section('everything')}><T s={s.nav.everything} /></a>
    </nav>
    <div class="nav-r">
      <Langs />
      <ThemeSwitch />
      <a class="btn btn-ghost btn-sm nav-ghost" href="https://github.com/risenxxx/frame-player">
        <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-github"/></svg>GitHub
      </a>
      <a class="btn btn-primary btn-sm nav-dl" href={download}><T s={s.nav.download} /></a>
      <a class="btn btn-primary btn-sm nav-dl nav-dl-windows" href={windows}><T s={s.nav.download} /></a>
      <a class="btn btn-primary btn-sm nav-dl nav-dl-macos" href={macos}><T s={s.nav.download} /></a>
    </div>
  </div>
</header>
<LangHint />
