---
import TitleBar from './mocks/TitleBar.astro'
import Frame from './Frame.astro'
import T from '../i18n/T.astro'
import { useLocale } from '../i18n/index.ts'

const { s } = useLocale(Astro)
---

  <section class="feat" id="resume">
    <div class="wrap feat-in">
      <div class="feat-copy" data-reveal>
        <h2><T s={s.resume.h} /></h2>
        <p class="lede">
          <T s={s.resume.lede} />
        </p>
        <ul class="checks">
          {s.resume.checks.map((check) => (
            <li><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-check"/></svg>
            <span><T s={check} /></span></li>
          ))}
        </ul>
      </div>
      <div class="feat-mock" data-reveal style="--dl:1">
        <div class="win" data-scene data-dur="2800" aria-hidden="true">
          <TitleBar />
          <div class="startscr">
            <p class="st-title">Frame Player</p>
            <p class="st-hint"><T s={s.mock.start.hint} /></p>
            <div class="st-actions">
              <span class="btn btn-primary btn-sm"><T s={s.mock.start.openFile} /></span>
              <span class="btn btn-ghost btn-sm"><T s={s.mock.start.openLink} /></span>
              <span class="btn btn-catalog btn-sm"><T s={s.mock.start.catalog} /></span>
            </div>
            <p class="st-sec"><T s={s.mock.start.continue} /></p>
            <div class="rail">
              <div class="card now" style="--i:0">
                <span class="card-poster"><Frame name="earth-aurora" slot="card" alt={s.alt.earthAurora} /><span class="card-progress" style="--v:62%"></span></span>
                <span class="card-name"><T s={s.mock.torrent.show} /><span class="sep"></span>S02E03</span>
                <span class="card-left"><T s={s.mock.common.left} p={{ t: '23:14' }} /></span>
              </div>
              <div class="card" style="--i:1">
                <span class="card-poster"><Frame name="lake-galaxy" slot="card" alt={s.alt.lakeGalaxy} /><span class="card-progress" style="--v:18%"></span></span>
                <span class="card-name"><T s={s.mock.start.longNight} /></span>
                <span class="card-left"><T s={s.mock.common.left} p={{ t: '1:41:02' }} /></span>
              </div>
              <div class="card" style="--i:2">
                <span class="card-poster"><Frame name="highway-trails" slot="card" alt={s.alt.highwayTrails} /><span class="card-progress" style="--v:88%"></span></span>
                <span class="card-name"><T s={s.mock.start.highway} /></span>
                <span class="card-left"><T s={s.mock.common.left} p={{ t: '6:28' }} /></span>
              </div>
              <div class="card" style="--i:3">
                <span class="card-poster"><Frame name="moon-eclipse" slot="card" alt={s.alt.moonEclipse} /><span class="card-progress" style="--v:41%"></span></span>
                <span class="card-name">youtube.com<span class="sep"></span><T s={s.mock.start.totality} /></span>
                <span class="card-left"><T s={s.mock.start.link} /></span>
              </div>
            </div>
            <p class="st-sec"><T s={s.mock.start.torrents} /></p>
            <div class="torrow">
              <span class="glyph"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-down"/></svg></span>
              <span>
                <span class="t1"><T s={s.mock.torrent.show} /><span class="sep"></span><T s={s.mock.torrent.season} /></span>
                <span class="t2 mono"><T s={s.mock.start.videos} /><span class="sep"></span><T s={s.mock.start.onDisk} /><span class="sep"></span><T s={s.mock.start.continueAt} /></span>
              </span>
              <span class="tag">RSS</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
