---
import TitleBar from './TitleBar.astro'
import T from '../../i18n/T.astro'
import { useLocale } from '../../i18n/index.ts'

const { s } = useLocale(Astro)
---

<div class="win" data-scene data-dur="3000" aria-hidden="true">
  <TitleBar><T s={s.mock.torrent.show} /><span class="sep"></span><T s={s.mock.torrent.season} /></TitleBar>
  <div class="rows">
    <div class="row done">
      <svg class="ic ico" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-check"/></svg>
      <span class="nm">S02E01.2160p.HDR.DV.mkv</span><span class="meta"><T s={s.mock.torrent.watched} /></span>
    </div>
    <div class="row done">
      <svg class="ic ico" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-check"/></svg>
      <span class="nm">S02E02.2160p.HDR.DV.mkv</span><span class="meta"><T s={s.mock.torrent.watched} /></span>
    </div>
    <div class="row on">
      <svg class="ic ico" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-play"/></svg>
      <span class="nm">S02E03.2160p.HDR.DV.mkv</span><span class="meta"><T s={s.mock.common.left} p={{ t: '23:14' }} /></span>
    </div>
    <div class="row">
      <svg class="ic ico" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-file"/></svg>
      <span class="nm">S02E04.2160p.HDR.DV.mkv</span><span class="meta">4.1 GB</span>
    </div>
  </div>
  <div class="bandbar">
    <span class="bands">
      <i style="--at:0%;--w:34%"></i>
      <i style="--at:44%;--w:12%"></i>
      <i style="--at:72%;--w:9%"></i>
    </span>
    <span class="play"></span>
  </div>
  <div class="torfoot">
    <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-down"/></svg>
    <span class="rate">4.2 MB/s</span>
    <span class="grow"><T s={s.mock.common.peers} p={{ n: 28 }} /></span>
    <span class="tag"><T s={s.mock.torrent.seedingOff} /></span>
  </div>
</div>
