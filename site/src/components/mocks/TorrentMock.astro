  <div class="rows">
    <div class="row done">
      <svg class="ic ico" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-check"/></svg>
      <span class="nm">S02E01.2160p.HDR.DV.mkv</span><span class="meta">watched</span>
    </div>
    <div class="row done">
      <svg class="ic ico" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-check"/></svg>
      <span class="nm">S02E02.2160p.HDR.DV.mkv</span><span class="meta">watched</span>
    </div>
    <div class="row on">
      <svg class="ic ico" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-play"/></svg>
      <span class="nm">S02E03.2160p.HDR.DV.mkv</span><span class="meta">23:14 left</span>
