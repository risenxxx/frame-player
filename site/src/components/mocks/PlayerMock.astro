---
/*
  The player window with a film playing, rebuilt from the application's own
  measurements — the hero draws it, and so does every guide that needs to show
  the player itself, so the two can never disagree about what it looks like.

  `kind` picks what is on the picture, and each kind names its frames in a
  literal `<Frame name slot>`: scripts/images.mjs finds what a picture is used
  for by reading those tags, so a name or a slot passed in as a variable would
  be invisible to it.

    hero     everything at once: the torrent readout, the skip button and a
             hover preview with its chapter
    torrent  a torrent playing while it downloads, readout in the corner
    preview  the hover preview above the seekbar, and the chapter it is in
    audio    the audio track menu open over the control bar
*/
import Frame from '../Frame.astro'
import T from '../../i18n/T.astro'
import { useLocale } from '../../i18n/index.ts'

interface Props {
  kind: 'hero' | 'torrent' | 'preview' | 'audio'
}

const { kind } = Astro.props

const TITLE = {
  hero: 'Orbital.Night.S02E04.2160p.HDR.DV.mkv',
  torrent: 'Night.Highway.2023.1080p.WEB-DL.mkv',
  preview: 'The.Long.Night.2024.2160p.mkv',
  audio: 'The.Long.Night.2024.2160p.mkv',
}

const torrent = kind === 'hero' || kind === 'torrent'
const hover = kind === 'hero' || kind === 'preview'

/* Where the playhead is, how much is buffered and where the cursor rests, as
   shares of the track — each agreeing with the times printed above it. `--disk`
   is the readout's bar, how much of the file is on disk, which has to be the sum
   of what the track shades. */
const TRACK = {
  hero: '--pos:7.4%;--buf:46%;--hover:24%',
  torrent: '--pos:0.2%;--buf:7.5%;--disk:11.5%',
  preview: '--pos:29.4%;--buf:100%;--hover:52%',
  audio: '--pos:59.6%;--buf:100%',
}

const { s } = useLocale(Astro)
---

<div
  class:list={['player', 'full', kind]}
  data-scene
  data-dur={kind === 'audio' ? 2000 : 1600}
  data-ease="linear"
  style={TRACK[kind]}
  aria-hidden="true"
>
  {kind === 'hero' && <Frame name="orion-moon" slot="hero" class="scene" alt={s.alt.orionMoon} loading="eager" fetchpriority="high" />}
  {kind === 'torrent' && <Frame name="highway-trails" slot="guide" class="scene" alt={s.alt.highwayTrails} />}
  {kind === 'preview' && <Frame name="lake-galaxy" slot="guide" class="scene" alt={s.alt.lakeGalaxy} />}
  {kind === 'audio' && <Frame name="lake-trails" slot="guide" class="scene" alt={s.alt.lakeTrails} />}
  <span class="p-scrim"></span>
  <span class="p-bar">
    <span class="lights"><i></i><i></i><i></i></span>
    <span class="p-title">{TITLE[kind]}</span>
    <span class="p-brand"><span>Frame Player</span>
      <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-mark"/></svg>
    </span>
  </span>

  {torrent && (
    <div class="torchip">
      <span class="torchip-line">
        <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-down"/></svg>
        <span class="mono" data-say={`{rate} MB/s{sep}${s.mock.common.peers}`}>4.2 MB/s<span class="sep"></span><T s={s.mock.common.peers} p={{ n: 28 }} /></span>
      </span>
      <span class="torchip-bar"><i></i></span>
    </div>
  )}

  {kind === 'hero' && (
    <span class="skip"><T s={s.mock.player.skipIntro} />
      <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#p-skip"/></svg>
    </span>
  )}

  <div class="osc">
    <div class="times mono">
      {kind === 'audio' && (
        <div class="trackpop">
          <div class="trackpop-title"><T s={s.mock.player.audioTrack} /></div>
          <div class="trackrow sel"><T s={s.mock.player.tracks[0]!} /><span class="sep"></span>eng</div>
          <div class="trackrow"><T s={s.mock.player.tracks[1]!} /><span class="sep"></span>eng</div>
          <div class="trackrow"><T s={s.mock.player.tracks[2]!} /><span class="sep"></span>rus</div>
          <div class="trackrow"><T s={s.mock.common.addFile} /></div>
          <div class="trackpop-rule"></div>
          <div class="trackpop-title"><T s={s.mock.player.delay} /></div>
          <div class="delayrow">
            <span class="delaybtn">−</span>
            <span class="delayval mono">0.00 s</span>
            <span class="delaybtn">+</span>
            <span class="delaysep"></span>
            <span class="delayreset"><T s={s.mock.player.reset} /></span>
          </div>
        </div>
      )}
      {kind === 'hero' && <><span>4:12</span><span>56:55</span></>}
      {kind === 'torrent' && <><span>0:09</span><span>1:48:36</span></>}
      {kind === 'preview' && <><span>31:40</span><span>1:47:52</span></>}
      {kind === 'audio' && <><span>1:04:18</span><span>1:47:52</span></>}
    </div>
    <div class="seekwrap">
      {kind === 'hero' && (
        <div class="hovertip">
          <span class="thumb"><Frame name="earth-aurora" slot="thumb" alt={s.alt.earthAurora} loading="eager" /></span>
          <span class="tip-time mono">13:39</span>
          <span class="tip-chapter"><T s={s.mock.player.chapter} /><span class="sep"></span><T s={s.mock.player.chapterName} /></span>
        </div>
      )}
      {kind === 'preview' && (
        <div class="hovertip">
          <span class="thumb"><Frame name="lake-tent" slot="thumb" alt={s.alt.lakeTent} /></span>
          <span class="tip-time mono">56:05</span>
          <span class="tip-chapter"><T s={s.mock.player.chapterCamp} /></span>
        </div>
      )}
      <div class="seektrack">
        <span class="buffered"></span>
        {kind === 'torrent' && (
          <>
            {/* What a torrent a few seconds in actually has on disk, as the
                application draws `torrent.buffered`: the stretch ahead of the
                playhead, a few pieces the swarm handed over out of order, and
                the file's last pieces — mpv reads a Matroska file's index from
                its end before it plays a frame. */}
            <span class="buffered" style="left:13.5%;width:1.4%"></span>
            <span class="buffered" style="left:22%;width:0.8%"></span>
            <span class="buffered" style="left:98.2%;width:1.8%"></span>
          </>
        )}
        <span class="fill"></span>
        {kind !== 'torrent' && (
          <>
            <span class="chap" style="--at:12%"></span>
            <span class="chap" style="--at:28.6%"></span>
            <span class="chap" style="--at:61%"></span>
          </>
        )}
        <span class="knob"></span>
      </div>
      {hover && <svg class="cursor" viewBox="0 0 15 19" width="15" height="19" aria-hidden="true"><use href="#i-hand"/></svg>}
    </div>
    <div class="controls">
      <div class="cluster left">
        <span class="b"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#p-volume"/></svg></span>
        <span class="volume"><i></i><b></b></span>
        {kind === 'hero' && <span class="speed mono">1.25×</span>}
      </div>
      <div class="cluster center">
        <span class="b"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#p-prev"/></svg></span>
        <span class="b play"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#p-play"/></svg></span>
        <span class="b"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#p-next"/></svg></span>
      </div>
      <div class="cluster right">
        <span class="b opt"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#p-loop"/></svg></span>
        {kind !== 'torrent' && (
          <>
            <span class="b opt"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#p-queue"/></svg></span>
            <span class:list={['b', kind === 'audio' ? 'on' : 'opt']}><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#p-audio"/></svg></span>
          </>
        )}
        <span class="b opt"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#p-subs"/></svg></span>
        <span class="b opt"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#p-cast"/></svg></span>
        <span class="b"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#p-full"/></svg></span>
      </div>
    </div>
  </div>
</div>
