---
import Frame from '../Frame.astro'
import T from '../../i18n/T.astro'
import { useLocale } from '../../i18n/index.ts'

const { s } = useLocale(Astro)
---

<div class="room-panel" aria-hidden="true">
  <div class="room-top">
    <span class="roomcode"><T s={s.mock.room.code} /> <b>K7QF2M</b></span>
    <span class="sync-pulse"><T s={s.mock.room.seek} /><span class="sep"></span><T s={s.mock.room.sameFrame} /></span>
    <span class="room-state"><T s={s.mock.room.inSync} /><span class="sep"></span>±0.04 s</span>
  </div>
  <div class="room-members">
    <span class="member"><span class="av"><T s={s.mock.room.youInitial} /></span><b><T s={s.mock.room.you} /></b><span class="sep"></span><T s={s.mock.room.host} /></span>
    <span class="member"><span class="av"><T s={s.mock.room.friendInitials} /></span><b><T s={s.mock.room.friend} /></b><span class="sep"></span><T s={s.mock.room.joined} /></span>
  </div>
</div>
<div class="rigs live" aria-hidden="true">
  <div class="rig laptop">
    <div class="rig-screen">
      <Frame name="lake-galaxy" slot="rig" class="scr-frame f1" alt={s.alt.lakeGalaxy} />
      <Frame name="lake-tent" slot="rig" class="scr-frame f2" alt={s.alt.lakeTent} />
      <Frame name="lake-trails" slot="rig" class="scr-frame f3" alt={s.alt.lakeTrails} />
      <div class="scr-osc">
        <div class="scr-track"><span class="sfill"></span><i></i></div>
      </div>
      <span class="scr-time"><span class="t1">18:22</span><span class="t2">41:07</span><span class="t3">57:44</span></span>
    </div>
    <span class="rig-base"></span>
    <span class="rig-label"><b><T s={s.mock.room.you} /></b><span class="sep"></span><T s={s.mock.room.laptop} /></span>
  </div>
  <div class="rig desk">
    <div class="rig-screen">
      <Frame name="lake-galaxy" slot="rig" class="scr-frame f1" alt={s.alt.lakeGalaxy} />
      <Frame name="lake-tent" slot="rig" class="scr-frame f2" alt={s.alt.lakeTent} />
      <Frame name="lake-trails" slot="rig" class="scr-frame f3" alt={s.alt.lakeTrails} />
      <div class="scr-osc">
        <div class="scr-track"><span class="sfill"></span><i></i></div>
      </div>
      <span class="scr-time"><span class="t1">18:22</span><span class="t2">41:07</span><span class="t3">57:44</span></span>
    </div>
    <span class="rig-neck"></span>
    <span class="rig-foot"></span>
    <span class="rig-label"><b><T s={s.mock.room.friend} /></b><span class="sep"></span><T s={s.mock.room.desktop} /></span>
  </div>
</div>
