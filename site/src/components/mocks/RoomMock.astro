---
import Frame from '../Frame.astro'
---

<div class="room-panel" aria-hidden="true">
  <div class="room-top">
    <span class="roomcode">Code <b>K7QF2M</b></span>
    <span class="sync-pulse">seek<span class="sep"></span>both on the same frame</span>
    <span class="room-state">in sync<span class="sep"></span>±0.04 s</span>
  </div>
  <div class="room-members">
    <span class="member"><span class="av">Y</span><b>You</b><span class="sep"></span>host</span>
    <span class="member"><span class="av">AN</span><b>Anna</b><span class="sep"></span>joined</span>
  </div>
</div>
<div class="rigs live" aria-hidden="true">
  <div class="rig laptop">
    <div class="rig-screen">
      <Frame name="lake-galaxy" slot="rig" class="scr-frame f1" alt="The Milky Way reflected in a mountain lake" />
      <Frame name="lake-tent" slot="rig" class="scr-frame f2" alt="A lit tent on the shore of a mountain lake" />
      <Frame name="lake-trails" slot="rig" class="scr-frame f3" alt="Star trails turning above a mountain lake" />
      <div class="scr-osc">
        <div class="scr-track"><span class="sfill"></span><i></i></div>
      </div>
      <span class="scr-time"><span class="t1">18:22</span><span class="t2">41:07</span><span class="t3">57:44</span></span>
    </div>
    <span class="rig-base"></span>
    <span class="rig-label"><b>You</b><span class="sep"></span>laptop</span>
  </div>
  <div class="rig desk">
    <div class="rig-screen">
      <Frame name="lake-galaxy" slot="rig" class="scr-frame f1" alt="The Milky Way reflected in a mountain lake" />
      <Frame name="lake-tent" slot="rig" class="scr-frame f2" alt="A lit tent on the shore of a mountain lake" />
      <Frame name="lake-trails" slot="rig" class="scr-frame f3" alt="Star trails turning above a mountain lake" />
      <div class="scr-osc">
        <div class="scr-track"><span class="sfill"></span><i></i></div>
      </div>
      <span class="scr-time"><span class="t1">18:22</span><span class="t2">41:07</span><span class="t3">57:44</span></span>
    </div>
    <span class="rig-neck"></span>
    <span class="rig-foot"></span>
    <span class="rig-label"><b>Anna</b><span class="sep"></span>desktop</span>
  </div>
</div>
