+        embedObservers.append(NotificationCenter.default.addObserver(
+            forName: NSWindow.didChangeScreenProfileNotification,
+            object: hostWindow,
+            queue: .main,
+            using: { [weak self] (_) in self?.windowDidChangeScreenProfile() }
+        ))
+    }
