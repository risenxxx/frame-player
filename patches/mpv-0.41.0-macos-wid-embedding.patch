+    /// Install our render view into a host-provided NSView (--wid) as the
+    /// bottom-most subview, so anything the host already put there (e.g. a
+    /// transparent WKWebView) composites on top of the video.
+    func embed(into parent: NSView, _ view: View) {
+        embedView = parent
+
+        view.frame = parent.bounds
+        view.autoresizingMask = [.width, .height]
+        parent.addSubview(view, positioned: .below, relativeTo: nil)
+        view.layer?.contentsScale = parent.window?.backingScaleFactor ?? 1
+
+        addEmbedObservers(parent)
+
+        log.verbose("Embedded into host NSView via --wid: " +
+                    "\(Int(parent.bounds.width))x\(Int(parent.bounds.height)) " +
+                    "@\(view.layer?.contentsScale ?? 1)x")
+    }
+
+    /// Without an NSWindow of our own there are no window-delegate callbacks, so
+    /// resize / DPI / screen changes have to come from notifications instead.
+    func addEmbedObservers(_ parent: NSView) {
+        parent.postsFrameChangedNotifications = true
+        embedObservers.append(NotificationCenter.default.addObserver(
+            forName: NSView.frameDidChangeNotification,
+            object: parent,
+            queue: .main,
+            using: { [weak self] (_) in self?.embedDidResize() }
+        ))
